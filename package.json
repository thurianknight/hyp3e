{
  "name": "hyp3e",
  "version": "1.0.0",
  "description": "CSS compiler for the Hyp3e system",
  "scripts": {
    "test:templates": "node --test tests/templates.test.mjs",
    "test:migrations": "node --test tests/effect-migrations.test.mjs",
    "test:packaging": "python -B -m unittest discover -s tests -p test_release_packaging.py -v",
    "release:build": "python -B create-release.py --build-only",
    "build": "gulp build",
    "compile": "gulp css",
    "watch": "gulp",
    "gulp": "gulp"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "John Doe",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-sass": "^5.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "sass": "^1.53.0"
  }
}
