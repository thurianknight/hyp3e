<li class="folder flexcol">
  <header class="folder-header" style="background: linear-gradient(90deg, {{this.initGroup}}, {{this.initGroup}}, transparent)">
    {{#if this.canRollInitiative}}
    <a data-action="roll-group-initiative" data-init-group="{{this.initGroup}}" title="Roll {{this.initGroup}} initiative">
      <i class="fas fa-dice-d6" style="padding-right: 0.3em;"></i> 
      <span class="folder-name"> {{localize this.label}}</span>
    </a>
    {{else}}
      <i class="fas fa-dice-d6" style="opacity: 0.5; padding-right: 0.3em;"></i> 
      <span class="folder-name">{{localize this.label}}</span>
    {{/if}}
    <span class="create-button">
        {{this.initiative}}
    </span>
  </header>

  <ol class="subdirectory plain" style="border-left: 4px solid {{this.initGroup}};">
    {{#each turns}}
    {{> "combat-tracker-combatant-ind-v13" }}
    {{/each}}
  </ol>
</li>
