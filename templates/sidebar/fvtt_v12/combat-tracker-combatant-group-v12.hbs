<li class="folder flexcol">
    <header class="folder-header flexrow" style="background: linear-gradient(90deg, var(--hyp3e-group-color-{{this.initGroup}}, {{this.initGroup}}), transparent)">
        <h3 class="noborder"><i class="fas fa-dice-d6"></i>{{localize this.label}}</h3>

        <span class="create-button" style="font-weight: 600; font-size: 1.25em;">
            {{this.initiative}}
        </span>
    </header>

    <ol class="subdirectory">
        {{#each this.turns}}
        <li class="combatant actor directory-item flexrow {{this.css}}" data-combatant-id="{{this.id}}">
            <img class="token-image" data-src="{{this.img}}" alt="{{this.name}}"/>
            <div class="token-name flexcol">
                <strong class="name">{{this.name}}</strong>
                <div class="combatant-controls flexrow">
                    {{!-- {{#if this.isOwnedByUser}} --}}
                    <a
                        class='combatant-control move-combat{{#if this.isMelee}} active{{/if}}'
                        data-tooltip="{{localize 'HYP3E.combat.meleeDeclared'}}"
                        role="button"
                        {{#if this.isOwnedByUser}}data-control="melee"{{/if}}
                    >
                        <i class='fas fa-sword'></i>
                    </a>
                    <a
                        class='combatant-control move-combat{{#if this.isMissile}} active{{/if}}'
                        data-tooltip="{{localize 'HYP3E.combat.missileDeclared'}}"
                        role="button"
                        {{#if this.isOwnedByUser}}data-control="missile"{{/if}}
                    >
                        <i class='fas fa-bow-arrow'></i>
                    </a>
                    <a
                        class='combatant-control move-combat{{#if this.isMagic}} active{{/if}}'
                        data-tooltip="{{localize 'HYP3E.combat.magicDeclared'}}"
                        role="button"
                        {{#if this.isOwnedByUser}}data-control="magic"{{/if}}
                    >
                        <i class='fas fa-scroll'></i>
                    </a>
                    <a
                        class='combatant-control move-combat{{#if this.isMovement}} active{{/if}}'
                        data-tooltip="{{localize 'HYP3E.combat.moveDeclared'}}"
                        role="button"
                        {{#if this.isOwnedByUser}}data-control="movement"{{/if}}
                    >
                        <i class='fas fa-walking'></i>
                    </a>
                    <a
                        class='combatant-control move-combat{{#if this.isOther}} active{{/if}}'
                        data-tooltip="{{localize 'HYP3E.combat.otherDeclared'}}"
                        role="button"
                        {{#if this.isOwnedByUser}}data-control="other"{{/if}}
                    >
                        <i class='fas fa-hands'></i>
                    </a>
                    {{!-- {{/if}} --}}
                    {{#if @root.user.isGM}}
                    <a class="combatant-control {{#if this.hidden}}active{{/if}}" aria-label="{{localize 'COMBAT.ToggleVis'}}" role="button" data-tooltip="COMBAT.ToggleVis" data-control="toggleHidden">
                        <i class="fas fa-eye-slash"></i>
                    </a>
                    <a class="combatant-control {{#if this.defeated}}active{{/if}}" aria-label="{{localize 'COMBAT.ToggleDead'}}" role="button" data-tooltip="COMBAT.ToggleDead" data-control="toggleDefeated">
                        <i class="fas fa-skull"></i>
                    </a>
                    {{/if}}
                    {{#if this.canPing}}
                    <a class="combatant-control" aria-label="{{localize 'COMBAT.PingCombatant'}}" role="button" data-tooltip="COMBAT.PingCombatant" data-control="pingCombatant">
                        <i class="fa-solid fa-bullseye-arrow"></i>
                    </a>
                    {{/if}}
                    {{#unless @root.user.isGM}}
                    <a class="combatant-control" aria-label="{{localize 'COMBAT.PanToCombatant'}}" role="button" data-tooltip="COMBAT.PanToCombatant" data-control="panToCombatant">
                        <i class="fa-solid fa-arrows-to-eye"></i>
                    </a>
                    {{/unless}}
                    <div class="token-effects {{#if this.isSlowed}}bg-trans-yellow{{/if}}">
                    {{#each this.effects}}
                        <img class="token-effect" src="{{this}}"/>
                    {{/each}}
                    </div>
                </div>
            </div>

            {{#if this.hasResource}}
            <div class="token-resource">
                <span class="resource">{{this.resource}}</span>
            </div>
            {{/if}}

            <div class="token-initiative">
                {{#if this.defeated}}
                    <i class="fa fa-dizzy"></i>
                {{else if this.hasRolled}}
                    {{#if (eq this.logLevel 0)}}
                    <span class="initiative">{{this.initiative}}</span>
                    {{/if}}
                {{/if}}
            </div>
        </li>
        {{/each}}
    </ol>
</li>
