    <li class="combatant directory-item {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant">

        {{!-- Image --}}
        <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

        {{!-- Name & Controls --}}
        <div class="token-name">
            <strong class="name">{{ name }}</strong>

            <div class="combatant-controls">
                {{!-- {{#if this.isOwnedByUser}} --}}
                {{!-- Combat action declaration buttons --}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-sword {{#if isMelee}}active{{/if}}"
                        data-action="melee" data-tooltip="{{localize 'HYP3E.combat.meleeDeclared'}}"
                        aria-label="{{localize 'HYP3E.combat.meleeDeclared'}}"></button>
                <button type="button" class="inline-control combatant-control icon fa-solid fa-bow-arrow {{#if isMissile}}active{{/if}}"
                        data-action="missile" data-tooltip="{{localize 'HYP3E.combat.missileDeclared'}}"
                        aria-label="{{localize 'HYP3E.combat.missileDeclared'}}"></button>
                <button type="button" class="inline-control combatant-control icon fa-solid fa-scroll {{#if isMagic}}active{{/if}}"
                        data-action="magic" data-tooltip="{{localize 'HYP3E.combat.magicDeclared'}}"
                        aria-label="{{localize 'HYP3E.combat.magicDeclared'}}"></button>
                <button type="button" class="inline-control combatant-control icon fa-solid fa-walking {{#if isMovement}}active{{/if}}"
                        data-action="movement" data-tooltip="{{localize 'HYP3E.combat.moveDeclared'}}"
                        aria-label="{{localize 'HYP3E.combat.moveDeclared'}}"></button>
                <span class="tooltip-initiative">Initiative: {{ initiative }}</span>
                {{!-- {{/if}} --}}
            </div>
            <div class="combatant-controls">
                {{#if @root.user.isGM}}
                {{!-- GM can set invisible or dead --}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                        data-action="toggleHidden" data-tooltip="COMBAT.ToggleVis"
                        aria-label="{{ localize "COMBAT.ToggleVis" }}"></button>
                <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                        data-action="toggleDefeated" data-tooltip="COMBAT.ToggleDead"
                        aria-label="{{ localize "COMBAT.ToggleDead" }}"></button>
                {{/if}}

                {{#if canPing}}
                {{!-- Ping token --}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
                        data-action="pingCombatant" data-tooltip="COMBAT.PingCombatant"
                        aria-label="{{ localize "COMBAT.PingCombatant" }}"></button>
                {{/if}}

                {{#unless @root.user.isGM}}
                {{!-- Pan to token --}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
                        data-action="panToCombatant" data-tooltip="COMBAT.PanToCombatant"
                        aria-label="{{ localize "COMBAT.PanToCombatant" }}"></button>
                {{/unless}}

                {{!-- Actor/token effects --}}
                <div class="token-effects {{#if isSlowed}}bg-trans-yellow{{/if}}" data-tooltip="{{ effects.tooltip }}">
                    {{#each effects.icons}}
                    <img class="token-effect" src="{{ img }}" alt="{{ name }}">
                    {{/each}}
                </div>
            </div>
        </div>

        {{!-- Resource --}}
        {{#if resource includeZero=true}}
        <div class="token-resource">
            <span class="resource">{{ resource }}</span>
        </div>
        {{/if}}

        {{!-- Initiative --}}
        <div class="token-initiative">
            {{#if initiative includeZero=true}}
                {{!-- Initiative has been rolled --}}
                {{#if defeated}}
                <i class="fa fa-dizzy"></i>

                {{else}}
                    {{#unless isGroupInitiative}}
                    <span class="initiative">{{ initiative }}</span>
                    {{/unless}}
                {{/if}}
            {{!-- Roll Initiative --}}
            {{else if isOwner}}
                {{#unless isGroupInitiative}}
                <button type="button" class="combatant-control roll" data-action="rollInitiative"
                    data-tooltip="COMBAT.InitiativeRoll" aria-label="{{ localize "COMBAT.InitiativeRoll" }}"
                    style="--initiative-icon: url('{{ @root.initiativeIcon.icon }}'); --initiative-icon-hover: url('{{ @root.initiativeIcon.hover }}');"></button>
                {{/unless}}
            {{/if}}
        </div>

    </li>
