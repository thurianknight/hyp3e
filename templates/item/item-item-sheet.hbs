<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    <div class="header-block item-header-block">
      <h1 class="charname">
        {{#if isGM}}
        <input class="item-name" name="system.realName" type="text" value="{{system.realName}}" placeholder="Name"/>
        {{else}}
            {{#if system.identified}}
            <input class="item-name" name="system.realName" type="text" value="{{system.realName}}" placeholder="Name"/>
            {{else}}
            <input name="system.itemAlias" type="text" value="{{system.itemAlias}}" disabled/>
            {{/if}}
        {{/if}}
      </h1>
      {{#if isGM}}
      <div class="flexrow">
        <span class="flexrow">
            <input class="identified" name="system.identified" type="checkbox" {{checked system.identified}}>
            <label class="resource-label">{{localize 'HYP3E.identified'}}</label>
        </span>
        <span class="flexrow flexlarge flex-group-center">
            <label class="resource-label">{{localize 'HYP3E.itemAlias'}}</label>
            <input class="item-alias" type="text" style="text-align: left; min-width: 200px;" name="system.itemAlias" value="{{system.itemAlias}}" placeholder="Name if not identified" />
        </span>
      </div>
      {{/if}}
      <div class="flexrow">
        <div class="resource flexrow flex-group-center xp">
          <label class="resource-label">{{localize 'HYP3E.details.xp'}}</label>
          <input type="text" name="system.xp" value="{{system.xp}}" >
        </div>
        <div class="resource flexrow flex-group-center qty-wt">
          <label class="resource-label">{{localize 'HYP3E.item.qty'}}</label>
          <input type="text" name="system.quantity.value" value="{{system.quantity.value}}" data-dtype="Number"/>
          /
          <input type="text" name="system.quantity.max" value="{{system.quantity.max}}" data-dtype="Number"/>
          &nbsp;
          <label class="resource-label">{{localize 'HYP3E.item.wt'}}</label>
          <input type="text" name="system.weight" value="{{system.weight}}" data-dtype="Number"/>
        </div>
        <div class="resource flexrow flex-group-center gp-cost">
          <label class="resource-label">{{localize 'HYP3E.item.cost'}}</label>
          <input type="text" name="system.cost" value="{{system.cost}}" />
        </div>
        {{!-- <div class="resource flexrow flex-group-center">
          <label class="resource-label flexlarge">{{localize 'HYP3E.item.weight'}}</label>
          <input type="text" name="system.weight" value="{{system.weight}}" data-dtype="Number"/>
        </div> --}}
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize 'HYP3E.tabs.details'}}</a>
    <a class="item" data-tab="attributes">{{localize 'HYP3E.tabs.attributes'}}</a>
    {{#if system.spellcasting.hasSpells}}
        {{#if isGM}}
        <a class="item" data-tab="spells">{{localize 'HYP3E.tabs.spells'}}</a>
        {{else}}
            {{#if system.identified}}
            <a class="item" data-tab="spells">{{localize 'HYP3E.tabs.spells'}}</a>
            {{/if}}
        {{/if}}
    {{/if}}
    <a class="item" data-tab="effects">{{localize 'HYP3E.tabs.effects'}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      <div class="flexrow">

        {{!-- Item Attributes --}}
        <div class="flexshrink flex-group-center item-attributes">
          <label class="resource-label">{{localize 'HYP3E.item.location'}}</label>
          <input type="text" name="system.location" value="{{system.location}}" data-dtype="String" />
          {{#if isGM}}
          <label class="resource-label">{{localize 'HYP3E.checkRoll'}}</label>
          <input type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"/>
          <label class="resource-label">{{localize 'HYP3E.target'}}</label>
          <input type="text" name="system.tn" value="{{system.tn}}" data-dtype="String"/>
          <label class="resource-label">{{localize 'HYP3E.spell.save'}}</label>
          <div class="form-fields">
            <select name="system.save">
              <option value=""></option>
              {{selectOptions saveThrows selected=system.save localize=true}}
            </select>
          </div>
          {{else}}
            {{#if system.identified}}
            <label class="resource-label">{{localize 'HYP3E.checkRoll'}}</label>
            <input type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"/>
            <label class="resource-label">{{localize 'HYP3E.target'}}</label>
            <input type="text" name="system.tn" value="{{system.tn}}" data-dtype="String"/>
            <label class="resource-label">{{localize 'HYP3E.spell.save'}}</label>
            <div class="form-fields">
                <select name="system.save">
                <option value=""></option>
                {{selectOptions saveThrows selected=system.save localize=true}}
                </select>
            </div>
            {{/if}}
          {{/if}}
        </div>

        {{!-- Description Tab --}}
        <div class="flex item-description">
          <h3>{{localize 'HYP3E.tabs.description'}}</h3>
          {{!-- To render inline rolls in a TinyMCE editor, you need to pass the parent actor's (if any) roll data to the rollData prop. --}}
          {{!-- {{editor system.description target="system.description" rollData=rollData button=true owner=owner editable=editable}} --}}
          {{#if isGM}}
          {{editor enrichedRealDescription target="system.realDescription" rollData=rollData button=true owner=owner editable=editable}}
          <label for="system.aliasDescription" class="resource-label">{{localize 'HYP3E.aliasDescription'}}</label>
          <textarea name="system.aliasDescription">{{system.aliasDescription}}</textarea>
          {{else}}
            {{#if system.identified}}
            {{editor enrichedRealDescription target="system.realDescription" rollData=rollData button=true owner=owner editable=editable}}
            <textarea name="system.aliasDescription">{{system.aliasDescription}}</textarea>
            {{else}}
            <textarea name="system.aliasDescription">{{system.aliasDescription}}</textarea>
            {{/if}}
          {{/if}}
        </div>
      </div>
    </div>

    {{!-- Attributes Tab --}}
    <div class="tab attributes" data-group="primary" data-tab="attributes">
      {{!-- As you add new fields, add them in here! --}}
      <div class="resource">
        {{#if isGM}}
        <label class="resource-label">{{localize 'HYP3E.dataLabel.friendlyName'}}</label>
        <input type="text" name="system.friendlyName" value="{{system.friendlyName}}" />
        {{else}}
            {{#if system.identified}}
            <label class="resource-label">{{localize 'HYP3E.dataLabel.friendlyName'}}</label>
            <input type="text" name="system.friendlyName" value="{{system.friendlyName}}" />
            {{/if}}
        {{/if}}
        <div class="flexrow flexshrink flex-group-left bg-attributes">
          <label class="resource-label">{{localize 'HYP3E.item.carried'}}</label>
          <input name="system.equipped" type="checkbox" {{checked system.equipped}}>
          <div class="flex-xlarge">{{localize 'HYP3E.item.attributes.carried'}}</div>
        </div>
        <div class="flexrow flexshrink flex-group-left bg-attributes">
          <label class="resource-label">{{localize 'HYP3E.item.consumable'}}</label>
          <input name="system.isConsumable" type="checkbox" {{checked system.isConsumable}}>
          <div class="flex-xlarge">{{localize 'HYP3E.item.attributes.isConsumable'}}</div>
        </div>
        <div class="flexrow flexshrink flex-group-left bg-attributes">
          <label class="resource-label">{{localize 'HYP3E.item.ammunition'}}</label>
          <input name="system.isAmmunition" type="checkbox" {{checked system.isAmmunition}}>
          <div class="flex-xlarge">{{localize 'HYP3E.item.attributes.isAmmunition'}}</div>
        </div>
        <div class="flexrow flexshrink flex-group-left bg-attributes">
          <label class="resource-label">{{localize 'HYP3E.item.lightSource'}}</label>
          <input name="system.isLightSource" type="checkbox" {{checked system.isLightSource}}>
          <div class="flex-xlarge">{{localize 'HYP3E.item.attributes.isLightSource'}}</div>
        </div>
        {{#if system.isLightSource}}
        <fieldset>
            <div class="flexrow flexshrink flex-group-left bg-attributes">
                <label class="resource-label">{{localize 'HYP3E.item.light.lightRadius'}}</label>
                <div class="flex-xlarge">
                    {{localize 'HYP3E.item.light.dim'}}:
                    <input type="number" name="system.light.dim" value="{{system.light.dim}}">
                    {{localize 'HYP3E.item.light.bright'}}:
                    <input type="number" name="system.light.bright" value="{{system.light.bright}}">
                    {{localize 'HYP3E.item.attributes.lightRadius'}}
                </div>
            </div>
            <div class="flexrow flexshrink flex-group-left bg-attributes">
                <label class="resource-label">{{localize 'HYP3E.item.light.angle'}}</label>
                <input type="number" name="system.light.angle" value="{{system.light.angle}}">
                <div class="flex-xlarge">{{localize 'HYP3E.item.attributes.lightAngle'}}</div>
            </div>
            <div class="flexrow flexshrink flex-group-left bg-attributes-wide">
                <label class="resource-label">{{localize 'HYP3E.item.light.color'}}</label>
                <input type="text" name="system.light.color" value="{{system.light.color}}" data-type="color">
                <div class="flex-xlarge">
                    <div class="color-preview" style="background: {{system.light.color}};"></div>
                    {{localize 'HYP3E.item.attributes.lightColor'}}
                </div>
            </div>
        </fieldset>
        {{/if}}
        <div class="flexrow flexshrink flex-group-left bg-attributes">
          <label class="resource-label">{{localize 'HYP3E.item.duration'}}</label>
          <input type="number" name="system.duration" value="{{system.duration}}">
          <div class="flex-xlarge">{{localize 'HYP3E.item.attributes.duration'}}</div>
        </div>
        {{#if isGM}}
        <div class="flexrow flexshrink flex-group-left bg-attributes">
          <label class="resource-label">{{localize 'HYP3E.item.hasSpells'}}</label>
          <input name="system.spellcasting.hasSpells" type="checkbox" {{checked system.spellcasting.hasSpells}}>
          <div class="flex-xlarge">{{localize 'HYP3E.item.attributes.hasSpells'}}</div>
        </div>
        {{/if}}
        <label class="resource-label">{{localize 'HYP3E.dataLabel.itemId'}}</label>
        <input type="text" name="item._id" value="{{item._id}}" disabled/>
        {{#unless system.isContainer}}
        <label class="resource-label">{{localize 'HYP3E.dataLabel.containerId'}}</label>
        <input type="text" name="system.containerId" value="{{system.containerId}}"/>
        {{/unless}}
        <div class="flexrow flexshrink flex-group-left bg-attributes">
          <label class="resource-label">{{localize 'HYP3E.item.container'}}</label>
          <input id="system.isContainer" name="system.isContainer" type="checkbox" {{checked system.isContainer}}>
          <div class="flex-xlarge">{{localize 'HYP3E.item.attributes.isContainer'}}</div>
        </div>
      </div>
    </div>

    {{!-- Spells Tab --}}
    <div class="tab spells" data-group="primary" data-tab="spells">
      <div class="description-block">
        {{#if isGM}}
        {{> "item-spells"}}
        {{else}}
            {{#if system.identified}}
            {{> "item-spells"}}
            {{/if}}
        {{/if}}
      </div>
    </div>

    {{!-- Effects Tab --}}
    <div class="tab effects" data-group="primary" data-tab="effects">
      {{!-- As you add new fields, add them in here! --}}
      <div class="flex description-block">
        {{#if isGM}}
        {{> "item-effects"}}
        {{else}}
            {{#if system.identified}}
            {{> "item-effects"}}
            {{/if}}
        {{/if}}
      </div>
    </div>
  </section>
</form>
