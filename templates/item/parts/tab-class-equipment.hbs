<section 
    class="tab {{tabs.classEquipment.cssClass}}"
    data-tab="{{tabs.classEquipment.id}}"
    data-group="primary"
>
  <div class="main-content">
    {{!-- Class Starting Pack --}}
    <h3>{{localize 'HYP3E.classEditor.startingPack'}}</h3>
    <div class="flexrow form-group row-top">
      <div class="column-top" style="margin-right: 2px;">
        {{!-- General Equipment --}}
        {{#each system.startingPack}}

          {{#if (eq @key "equipment - general")}}
          <div class="flex">
            <label class="dialog-label">{{capitalizeWords @key}}</label>
            {{#each this}}
            <div class="flex flexrow flex-group-center">
              <select class="equipment-select" name="system.startingPack.{{@../key}}.{{@index}}.name">
                <option value=""></option>
                {{selectOptions @root.gearOptions selected=this.name localize=false}}
              </select>
              <input type="number" class="input-small" name="system.startingPack.{{@../key}}.{{@index}}.quantity" value="{{this.quantity}}" placeholder="Qty" />
              <button type="button" class="button-narrow" data-action="deleteItem" data-pack="{{@../key}}" data-index="{{@index}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" data-action="addItem" data-pack="{{@key}}"><i class="fas fa-plus"></i> {{localize 'HYP3E.classEditor.add'}}</button>
          </div>
          {{/if}}
        {{/each}}
      </div>
      <div class="flex">
        {{!-- Other categories: gold, armour, weapons, provisions, religious items --}}
        {{#each system.startingPack}}

          {{#if (eq @key "gold")}}
          <div class="flexrow flex-group-center">
            <label class="dialog-label">{{capitalizeWords @key}}</label>
            <input type="text" name="system.startingPack.gold" value="{{this}}" placeholder="Gold Amount" />
          </div>
          {{/if}}

          {{#if (eq @key "armour")}}
          <div class="column-top">
            <label class="dialog-label" style="padding-top: 20px;">{{capitalizeWords @key}}</label>
            {{#each this}}
            <div class="flex flexrow flex-group-center">
              <select class="equipment-select" name="system.startingPack.{{@../key}}.{{@index}}.name">
                <option value=""></option>
                {{selectOptions @root.armorOptions selected=this.name localize=false}}
              </select>
              <input type="number" class="input-small" name="system.startingPack.{{@../key}}.{{@index}}.quantity" value="{{this.quantity}}" placeholder="Qty" />
              <button type="button" class="button-narrow" data-action="deleteItem" data-pack="{{@../key}}" data-index="{{@index}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" data-action="addItem" data-pack="{{@key}}"><i class="fas fa-plus"></i> {{localize 'HYP3E.classEditor.add'}}</button>
          </div>
          {{/if}}

          {{#if (eq @key "weapons")}}
          <div class="column-top">
            <label class="dialog-label" style="padding-top: 20px;">{{capitalizeWords @key}}</label>
            {{#each this}}
            <div class="flex flexrow flex-group-center">
              <select class="equipment-select" name="system.startingPack.{{@../key}}.{{@index}}.name">
                <option value=""></option>
                {{selectOptions @root.weaponOptions selected=this.name localize=false}}
              </select>
              <input type="number" class="input-small" name="system.startingPack.{{@../key}}.{{@index}}.quantity" value="{{this.quantity}}" placeholder="Qty" />
              <button type="button" class="button-narrow" data-action="deleteItem" data-pack="{{@../key}}" data-index="{{@index}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" data-action="addItem" data-pack="{{@key}}"><i class="fas fa-plus"></i> {{localize 'HYP3E.classEditor.add'}}</button>
          </div>
          {{/if}}

          {{#if (eq @key "equipment - provisions")}}
          <div class="column-top">
            <label class="dialog-label" style="padding-top: 20px;">{{capitalizeWords @key}}</label>
            {{#each this}}
            <div class="flex flexrow flex-group-center">
              <select class="equipment-select" name="system.startingPack.{{@../key}}.{{@index}}.name">
                <option value=""></option>
                {{selectOptions @root.provisionOptions selected=this.name localize=false}}
              </select>
              <input type="number" class="input-small" name="system.startingPack.{{@../key}}.{{@index}}.quantity" value="{{this.quantity}}" placeholder="Qty" />
              <button type="button" class="button-narrow" data-action="deleteItem" data-pack="{{@../key}}" data-index="{{@index}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" data-action="addItem" data-pack="{{@key}}"><i class="fas fa-plus"></i> {{localize 'HYP3E.classEditor.add'}}</button>
          </div>
          {{/if}}

          {{#if (eq @key "equipment - religious")}}
          <div class="column-top">
            <label class="dialog-label" style="padding-top: 20px;">{{capitalizeWords @key}}</label>
            {{#each this}}
            <div class="flex flexrow flex-group-center">
              <select class="equipment-select" name="system.startingPack.{{@../key}}.{{@index}}.name">
                <option value=""></option>
                {{selectOptions @root.religiousOptions selected=this.name localize=false}}
              </select>
              <input type="number" class="input-small" name="system.startingPack.{{@../key}}.{{@index}}.quantity" value="{{this.quantity}}" placeholder="Qty" />
              <button type="button" class="button-narrow" data-action="deleteItem" data-pack="{{@../key}}" data-index="{{@index}}"><i class="fas fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" data-action="addItem" data-pack="{{@key}}"><i class="fas fa-plus"></i> {{localize 'HYP3E.classEditor.add'}}</button>
          </div>
          {{/if}}
        {{/each}}
      </div>
    </div>
  </div>

</section>
