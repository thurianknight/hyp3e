        {{!-- Class feature sidebar --}}
        <div class="flexshrink flex-group-center item-attributes">
          <label class="resource-label">{{localize 'HYP3E.details.class'}}</label>
          <input class="align-center" type="text" name="system.class" value="{{system.class}}" data-dtype="String"/>
          <label class="resource-label">{{localize 'HYP3E.details.level'}}</label>
          <input class="align-center" type="text" name="system.level" value="{{system.level}}" data-dtype="String"/>
          <label class="resource-label">{{localize 'HYP3E.checkRoll'}}</label>
          <input class="align-center" type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"/>
          <label class="resource-label">{{localize 'HYP3E.target'}}</label>
          <input class="align-center" type="text" name="system.tn" value="{{system.tn}}" data-dtype="String"/>
          <label class="resource-label">{{localize "HYP3E.rollMode"}}</label>
          <select name="system.rollMode">
            <option value=""></option>
            {{selectOptions rollModes selected=system.rollMode localize=true}}
          </select>
          <label class="resource-label">{{localize 'HYP3E.spell.save'}}</label>
          <div class="form-fields">
            <select name="system.save">
              <option value=""></option>
              {{selectOptions saveThrows selected=system.save localize=true}}
            </select>
          </div>
          <label for="system.damage" class="resource-label">{{localize 'HYP3E.headers.damage'}}</label>
          <a class="item-button item-control"
              aria-label="{{localize 'HYP3E.headers.damageTypes'}}"
              role="button"
              data-tooltip="HYP3E.headers.damageTypes"
              data-action="setDmgTypes">
            <i class="fas fa-book" style="font-size: small"></i>
          </a>
          <input class="align-center" type="text" name="system.damage" value="{{system.damage}}" />
          {{#if system.damage}}
          <span style="font-weight: bold; font-style: italic;">{{capitalizeWords system.dmgType}}</span>
          {{/if}}
        </div>
