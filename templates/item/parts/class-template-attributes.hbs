      {{!-- Class template attributes --}}
      <div class="resource">
        <h3>Class Attributes</h3>
          <fieldset>
            <legend>{{localize 'HYP3E.classEditor.attrReqs'}}</legend>
            <div class="flex flexrow flex-group-center form-group container">
              {{#each system.attrReqs}}
              <span>
                <input type="number" class="input-small" name="system.attrReqs.{{@key}}" value="{{this}}" /><br />
                <label for="system.attrReqs.{{@key}}">{{localize (concat "HYP3E.attributes." @key ".abbrev")}}</label>
              </span>
              {{/each}}
            </div>
          </fieldset>

          <fieldset>
            <legend>{{localize 'HYP3E.classEditor.xpBonusReqs'}}</legend>
            <p>{{localize 'HYP3E.classEditor.xpBonusReqsNote'}}</p>
            <div class="flex flexrow flex-group-center form-group container">
              {{#each system.xpBonusReq}}
              <span>
                <input type="number" class="input-small" name="system.xpBonusReq.{{@key}}" value="{{this}}" /><br />
                <label for="system.xpBonusReq.{{@key}}">{{localize (concat "HYP3E.attributes." @key ".abbrev")}}</label>
              </span>
              {{/each}}
            </div>
          </fieldset>

          <fieldset>
            <legend>{{localize 'HYP3E.classEditor.extrFeatReqs'}}</legend>
            <p>{{localize 'HYP3E.classEditor.extrFeatReqsNote'}}</p>
            <div class="flex flexrow flex-group-center form-group container">
              <span>
                <input type="number" class="input-small" name="system.featBonus.str" value="{{system.featBonus.str}}" /><br />
                <label for="system.featBonus.str">{{localize 'HYP3E.attributes.str.feat'}}</label>
              </span>
              <span>
                <input type="number" class="input-small" name="system.featBonus.dex" value="{{system.featBonus.dex}}" /><br />
                <label for="system.featBonus.dex">{{localize 'HYP3E.attributes.dex.feat'}}</label>
              </span>
              <span>
                <input type="number" class="input-small" name="system.featBonus.con" value="{{system.featBonus.con}}" /><br />
                <label for="system.featBonus.con">{{localize 'HYP3E.attributes.con.feat'}}</label>
              </span>
            </div>
          </fieldset>
      </div>
      <hr class="plain-hr"/>
      <fieldset>
        <legend title="{{localize 'HYP3E.classEditor.classFeaturesNote'}}">{{localize 'HYP3E.classEditor.classFeatures'}}</legend>
        <div class="flex">
          {{#each system.abilities}}
          <div class="flex flexrow flex-group-center form-group container">
              <input class="input-big" type="text" name="system.abilities.{{@index}}.name" value="{{this.name}}" placeholder="{{localize 'HYP3E.classEditor.featureNamePlaceholder'}}" /><br />
              <button type="button" class="button-narrow" data-action="deleteFeature" data-index="{{@index}}"><i class="fas fa-trash"></i> {{localize 'HYP3E.classEditor.delete'}}</button>
          </div>
          {{/each}}
        </div>
        <button type="button" data-action="addFeature"><i class="fas fa-plus"></i> {{localize 'HYP3E.classEditor.add'}}</button>
      </fieldset>
