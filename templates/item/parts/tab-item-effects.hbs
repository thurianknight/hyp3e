<section 
    class="tab {{tabs.effects.cssClass}}"
    data-tab="{{tabs.effects.id}}"
    data-group="primary"
>
  <div class="main-content">
    {{!-- Effects --}}
    <h2>{{localize 'HYP3E.headers.effectsCond'}}</h2>
    <ol class="items-list effects-list">
      {{#each effects as |section sid|}}
        <li class="items-header flexrow" data-effect-type="{{section.type}}">
          <h3 class="item-name effect-name">{{localize section.label}}</h3>
          <h3>{{localize "HYP3E.effect.source"}}</h3>
          <h3>{{localize "HYP3E.spell.duration"}}</h3>
          <h4 class="item-controls effect-controls">
            <a class="effect-control" 
                data-action="createEffect" 
                title="{{localize 'HYP3E.effect.create'}}">
              <i class="fas fa-plus"></i> {{localize "HYP3E.effect.add"}}
            </a>
          </h4>
        </li>

        <ol class="items-list">
        {{#each section.effects as |effect|}}
          <li class="item-entry item effect-entry" data-effect-id="{{effect.id}}">
            <div class="item-header flexrow">
              <div class="item-name effect-name">
                <img class="item-image" src="{{effect.img}}"/> 
                <span>{{effect.name}}</span>
              </div>
              <div class="item-prop">{{effect.sourceName}}</div>
              <div class="item-prop">{{effect.duration.label}}</div>
              <div class="item-controls effect-controls">
                <a class="effect-control" 
                    data-action="toggleEffect" 
                    data-effect-id="{{effect.id}}" 
                    title="{{localize 'HYP3E.effect.toggle'}}">
                  <i class="fas {{#if effect.disabled}}fa-check{{else}}fa-times{{/if}}"></i>
                </a>
                <a class="effect-control" 
                    data-action="editEffect" 
                    data-effect-id="{{effect.id}}" 
                    title="{{localize 'HYP3E.item.edit'}}">
                  <i class="fas fa-edit"></i>
                </a>
                <a class="effect-control" 
                    data-action="deleteEffect" 
                    data-effect-id="{{effect.id}}" 
                    title="{{localize 'HYP3E.item.delete'}}">
                  <i class="fas fa-trash"></i>
                </a>
              </div>
            </div>
          </li>
        {{/each}}
        </ol>
      {{/each}}
    </ol>
  </div>

</section>
