<section 
    class="tab {{tabs.details.cssClass}}"
    data-tab="{{tabs.details.id}}"
    data-group="primary"
>
  <div class="main-content">
    {{!-- Main & Description --}}
      <div class="flexrow tab-content">
        {{!-- Item-type specific sidebars --}}
        {{#if (eq item.type "armor")}}
          {{> "sidebar-armor"}}
        {{/if}}
        {{#if (eq item.type "shield")}}
          {{> "sidebar-shield"}}
        {{/if}}
        {{#if (eq item.type "feature")}}
          {{> "sidebar-feature"}}
        {{/if}}
        {{#if (eq item.type "item")}}
          {{> "sidebar-item"}}
        {{/if}}
        {{#if (eq item.type "spell")}}
          {{> "sidebar-spell"}}
        {{/if}}
        {{#if (eq item.type "weapon")}}
          {{> "sidebar-weapon"}}
        {{/if}}

        {{!-- Description --}}
        <div class="item-description">
          {{#if (eq item.type "classTemplate")}}
          {{#if system.spellcaster}}
          <fieldset>
            <legend title="{{localize 'HYP3E.classEditor.spellListsNote'}}">{{localize 'HYP3E.classEditor.spellLists'}}</legend>
            <div class="flex flexrow flex-group-center form-group container">
              <span class="flex-item">
                <select name="system.spellLists.0">
                  <option value=""></option>
                  {{selectOptions @root.spellLists selected=spells0 localize=false}}
                </select>
                <br />
                <label for="system.spellLists.0">{{localize 'HYP3E.classEditor.spellList'}} 1</label>        
              </span>
              <span class="flex-item">
                <select name="system.spellLists.1">
                  <option value=""></option>
                  {{selectOptions @root.spellLists selected=spells1 localize=false}}
                </select>
                <br />
                <label for="system.spellLists.1">{{localize 'HYP3E.classEditor.spellList'}} 2</label>        
              </span>
            </div>
          </fieldset>
          {{/if}}
          <fieldset style="padding-inline-start: 5px; padding-inline-end: 5px;">
            <legend title="{{localize 'HYP3E.classEditor.saveThrowsNote'}}">{{localize 'HYP3E.classEditor.saveThrows'}}</legend>
            <div class="flex flexrow flex-group-center form-group container">
              {{#each savingThrows}}
              <span>
                <input type="number" class="input-small" name="system.saves.{{@key}}" value="{{this.value}}" /><br />
                <label for="system.saves.{{@key}}">{{this.label}}</label>
              </span>
              {{/each}}
            </div>
          </fieldset>
          <fieldset style="padding-inline-start: 5px; padding-inline-end: 5px;">
            <legend>{{localize 'HYP3E.classEditor.proficiencies'}}</legend>
            <div class="flex">
              <div class="flex">
                <label for="system.weaponProficiencies.favoredWeapons">{{localize "HYP3E.classEditor.favoredWeapons"}}</label>
                <a class="languages-button item-control icon-btn" 
                    aria-label="{{localize 'HYP3E.classEditor.favoredWeapons'}}" 
                    role="button" 
                    data-tooltip="HYP3E.classEditor.favoredWeapons" 
                    data-action="setWeapons">
                  <i class="fas fa-book" style="font-size: small"></i>
                </a>
                <textarea name="system.weaponProficiencies.favoredWeapons" disabled>{{system.weaponProficiencies.favoredWeapons}}</textarea>
              </div>
              <div class="flexrow flex-group-center">
                <label for="system.weaponProficiencies.exceptions">{{localize "HYP3E.classEditor.exceptions"}}:</label>
                <a class="languages-button item-control icon-btn" 
                    aria-label="{{localize 'HYP3E.classEditor.exceptions'}}" 
                    role="button" 
                    data-tooltip="HYP3E.classEditor.exceptions" 
                    data-action="setExceptions">
                  <i class="fas fa-book" style="font-size: small"></i>
                </a>
                <input type="text" class="flex-xlarge" name="system.weaponProficiencies.exceptions" value="{{system.weaponProficiencies.exceptions}}" disabled />
              </div>
            </div>
          </fieldset>
          {{/if}}
          <h3>{{localize 'HYP3E.tabs.description'}}</h3>
          {{!-- To render inline rolls in a TinyMCE editor, you need to pass the parent actor's (if any) roll data to the rollData prop. --}}
          {{#if isGM}}
            {{#if editable}}
              <prose-mirror
                class="{{#if system.isPhysical}}prose-item-short{{else}}prose-item-tall{{/if}}"
                name="system.realDescription"
                button="true"
                editable="{{editable}}"
                toggled="false"
                value="{{system.realDescription}}">
                {{{realDescriptionHTML}}}
              </prose-mirror>
            {{else}}
              {{{realDescriptionHTML}}}
            {{/if}}
            {{#if system.isPhysical}}
              <label for="system.aliasDescription" class="resource-label">{{localize 'HYP3E.aliasDescription'}}</label>
              <textarea name="system.aliasDescription">{{system.aliasDescription}}</textarea>
            {{/if}}
          {{else}}
            {{#if system.isPhysical}}
              {{#if system.identified}}
                {{editor enrichedRealDescription target="system.realDescription" editable=editable button=true engine="prosemirror" collaborate=false}}
                {{#if editable}}
                  <prose-mirror 
                    class="prose-item-short"
                    name="system.realDescription"
                    button="true"
                    editable="{{editable}}"
                    toggled="false"
                    value="{{system.realDescription}}">
                    {{{realDescriptionHTML}}}
                  </prose-mirror>
                {{else}}
                  {{{realDescriptionHTML}}}
                {{/if}}
                <textarea name="system.aliasDescription">{{system.aliasDescription}}</textarea>
              {{else}}
                <textarea name="system.aliasDescription">{{system.aliasDescription}}</textarea>
              {{/if}}
            {{else}}
              {{#if editable}}
                <prose-mirror
                    class="prose-item-tall"
                    name="system.realDescription"
                    button="true"
                    editable="{{editable}}"
                    toggled="false"
                    value="{{system.realDescription}}">
                    {{{realDescriptionHTML}}}
                </prose-mirror>
              {{else}}
                {{{realDescriptionHTML}}}
              {{/if}}
            {{/if}}
          {{/if}}
        </div>
      </div>
  </div>
</section>