        <div class="flexrow">
          <div class="resource flexrow flex-group-center">
            <label class="resource-label">{{localize 'HYP3E.headers.atkRate'}}</label>
            <input class="align-center" type="text" name="system.rof" value="{{system.rof}}" />
          </div>
          <div class="resource flexrow flex-group-center">
            <label class="resource-label">{{localize 'HYP3E.weapon.atkType'}}</label>
            <div class="flexrow">
              <a class="{{#unless system.melee}}no-bonus{{/unless}}" data-action="toggleWeaponType" data-attack-type="melee" title='{{localize "HYP3E.weapon.type.melee"}}'><i class="fas fa-sword"></i></a>
              <a class="{{#unless system.missile}}no-bonus{{/unless}}" data-action="toggleWeaponType" data-attack-type="missile" title='{{localize "HYP3E.weapon.type.missile"}}'><i class="fas fa-bow-arrow"></i></a>
            </div>
          </div>
          {{#if system.melee}}
            <div class="resource flexrow flex-group-center narrow">
              <label class="resource-label">{{localize 'HYP3E.headers.wpnClass'}}</label>
              <input class="align-center" type="number" name="system.wc" value="{{system.wc}}" />
            </div>
          {{/if}}
          {{#if system.missile}}
            <div class="resource flexrow flex-group-center flexlarge">
              <label class="resource-label">{{localize 'HYP3E.weapon.range'}}</label>
              <div class="flexrow range">
                <input class="align-center" type="number" name="system.range.short" value="{{system.range.short}}" />
                <input class="align-center" type="number" name="system.range.medium" value="{{system.range.medium}}" />
                <input class="align-center" type="number" name="system.range.long" value="{{system.range.long}}" />
              </div>
            </div>
          {{/if}}
        </div>