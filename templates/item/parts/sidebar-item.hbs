        {{!-- Item sidebar --}}
        <div class="flexshrink flex-group-center item-attributes">
          <label class="resource-label">{{localize 'HYP3E.item.location'}}</label>
          <input class="align-center" type="text" name="system.location" value="{{system.location}}" data-dtype="String" />
          {{#if isGM}}
            <label class="resource-label">{{localize 'HYP3E.checkRoll'}}</label>
            <input class="align-center" type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"/>
            <label class="resource-label">{{localize 'HYP3E.target'}}</label>
            <input class="align-center" type="text" name="system.tn" value="{{system.tn}}" data-dtype="String"/>
            <label class="resource-label">{{localize 'HYP3E.spell.save'}}</label>
            <div class="form-fields">
              <select name="system.save">
                <option value=""></option>
                {{selectOptions saveThrows selected=system.save localize=true}}
              </select>
            </div>
          {{else}}
            {{#if system.identified}}
              <label class="resource-label">{{localize 'HYP3E.checkRoll'}}</label>
              <input class="align-center" type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"/>
              <label class="resource-label">{{localize 'HYP3E.target'}}</label>
              <input class="align-center" type="text" name="system.tn" value="{{system.tn}}" data-dtype="String"/>
              <label class="resource-label">{{localize 'HYP3E.spell.save'}}</label>
              <div class="form-fields">
                <select name="system.save">
                  <option value=""></option>
                  {{selectOptions saveThrows selected=system.save localize=true}}
                </select>
              </div>
            {{/if}}
          {{/if}}
        </div>