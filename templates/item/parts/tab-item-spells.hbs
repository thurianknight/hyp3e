<section 
    class="tab {{tabs.spells.cssClass}}"
    data-tab="{{tabs.spells.id}}"
    data-group="primary"
>
  <div class="main-content">
    {{!-- Casting ability --}}
    <h2>{{localize 'HYP3E.tabs.spells'}}</h2>
    <div class="flexrow flex-group-left">
      <div class="item spells-block">
        <span class="spells-label">{{localize "HYP3E.castingAbility"}}</span>
        <input class="spells" type="text" name="system.spellcasting.ca" value="{{system.spellcasting.ca}}" {{#unless isGM}}readonly{{/unless}}/>
      </div>
      <div class="item flexlarge spells-block">
        <span class="spells-label">{{localize "HYP3E.item.charges"}}</span>
        {{#if isGM}}
        <input class="spells" type="number" name="system.spellcasting.charges.value" value="{{system.spellcasting.charges.value}}" />
        /
        <input class="spells" type="number" name="system.spellcasting.charges.max" value="{{system.spellcasting.charges.max}}" />
        {{else}}
        {{#if system.spellcasting.hideCharges}}
        <input class="spells" type="text" value="??" readonly/>
        {{else}}
        <input class="spells" type="text" name="system.spellcasting.charges.value" value="{{system.spellcasting.charges.value}}" readonly/>
        /
        <input class="spells" type="text" name="system.spellcasting.charges.max" value="{{system.spellcasting.charges.max}}" readonly/>
        {{/if}}
        {{/if}}
        <span class="spells-label">({{localize "HYP3E.dataLabel.leaveBlank"}})</span>
      </div>
    </div>

    {{!-- Spells appear here --}}
    <ul class="items-list item-spells">
        <li class="item flexrow items-header">
            <div class="item-name">{{localize 'HYP3E.item.spellsAbilities'}}</div>
            <div class="item-prop">{{localize 'HYP3E.item.charges'}}</div>
            <div class="item-prop">{{localize 'HYP3E.details.level'}}</div>
            <div class="item-prop">{{localize 'HYP3E.dataLabel.viewRemove'}}</div>
        </li>
        {{#each spells as |entry idx|}}
        <li class="item-entry item spell-entry" data-index="{{idx}}" data-spell-id="{{entry.spell.uuid}}" draggable="true">
            <div class="item-header flexrow">
                <div class="item-name">
                    <div class="item-image">
                        <img src="{{entry.spell.img}}" title="{{entry.spell.name}}" width="24" height="24"/>
                    </div>
                    <a data-action="dropItemDescription" data-spell-id="{{entry.spell.uuid}}"><span class="item-drop">{{entry.spell.name}}</span></a>
                </div>
                <div class="item-prop spells-block">
                    <input type="hidden"
                        name="system.spellcasting.spellRefs.{{idx}}.uuid"
                        value="{{entry.uuid}}" />
                    <input class="spells" type="number" 
                        name="system.spellcasting.spellRefs.{{idx}}.charges" 
                        value="{{entry.charges}}" 
                        {{#unless @root.isGM}}readonly{{/unless}}
                    />
                </div>
                <div class="item-prop">{{entry.spell.system.spellLevel}}</div>
                <div class="item-controls">
                    <a class="item-control" title='{{localize "HYP3E.item.show"}}' data-action="openItemSheet" data-spell-id="{{entry.spell.uuid}}"><i class="fas fa-eye"></i></a>
                    <a class="item-control" title="{{localize 'HYP3E.item.delete'}}" data-action="deleteSpell" data-spell-id="{{entry.spell.uuid}}"><i class="fas fa-trash"></i></a>
                </div>
            </div>
            <div class="item-summary">
                <div class="item-description">
                    {{{entry.spell.system.description}}}
                </div>
            </div>
        </li>
        {{/each}}
    </ul>
  </div>

</section>
