<section class="all-content flexrow">
  <section class="main-content">
    {{!-- Casting ability --}}
    <h2>{{localize 'HYP3E.tabs.spells'}}</h2>
    <div class="flexrow flex-group-left">
      <div class="item">
        <span class="spells-label">{{localize "HYP3E.castingAbility"}}</span>
        <input type="text" class="spells" name="system.spellcasting.ca" value="{{system.spellcasting.ca}}" data-dtype="Number"/>
      </div>
      <div class="item flexlarge">
        <span class="spells-label">{{localize "Charges"}}</span>
        <input type="text" class="spells" name="system.spellcasting.charges.value" value="{{system.spellcasting.charges.value}}" data-dtype="Number"/>
        /
        <input type="text" class="spells" name="system.spellcasting.charges.max" value="{{system.spellcasting.charges.max}}" data-dtype="Number"/>
      {{!-- </div>
      <div class="item"> --}}
        <span class="spells-label">{{localize "(Leave blank if not used)"}}</span>
      </div>
    </div>

    {{!-- Spells appear here --}}
    <ul class="items-list">
        <li class="item flexrow items-header">
            <div class="item-name">{{localize 'Spells/Abilities'}}</div>
            <div class="item-prop">{{localize 'HYP3E.weapon.range'}}</div>
            <div class="item-prop">{{localize 'HYP3E.spell.duration'}}</div>
            <div class="item-prop">{{localize 'Controls'}}</div>
        </li>
        {{#each spells as |spell id|}}
        <li class="item-entry item" data-spell-id="{{spell.uuid}}">
            <div class="item-header flexrow">
                <div class="item-name">
                    <div class="item-image">
                        <img src="{{spell.img}}" title="{{spell.name}}" width="24" height="24"/>
                    </div>
                    <a><h4 class="item-drop">{{spell.name}}</h4></a>
                </div>
                <div class="item-prop">{{spell.system.range}}</div>
                <div class="item-prop">{{spell.system.duration}}</div>
                <div class="item-controls">
                    <a class="item-control item-show" title='{{localize "HYP3E.item.show"}}'><i class="fas fa-eye"></i></a>
                    <a class="item-control item-delete-spell" title="{{localize 'HYP3E.item.delete'}}"><i class="fas fa-trash"></i></a>
                </div>
            </div>
            <div class="item-summary">
                <div class="item-description">
                    <div>{{{spell.system.description}}}</div>
                </div>
            </div>
        </li>
        {{/each}}
    </ul>
  </section>
</section>
