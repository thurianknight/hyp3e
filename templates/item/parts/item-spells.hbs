<section class="all-content flexrow">
  <section class="main-content">
    {{!-- Casting ability --}}
    <h2>{{localize 'HYP3E.tabs.spells'}}</h2>
    <div class="flexrow flex-group-left">
      <div class="item">
        <span class="spells-label">{{localize "HYP3E.castingAbility"}}</span>
        <input type="text" class="spells" name="system.spellcasting.ca" value="{{system.spellcasting.ca}}" data-dtype="Number" {{#unless isGM}}readonly{{/unless}}/>
      </div>
      <div class="item flexlarge">
        <span class="spells-label">{{localize "HYP3E.item.charges"}}</span>
        {{#if isGM}}
        <input type="text" class="spells" name="system.spellcasting.charges.value" value="{{system.spellcasting.charges.value}}" data-dtype="Number" />
        /
        <input type="text" class="spells" name="system.spellcasting.charges.max" value="{{system.spellcasting.charges.max}}" data-dtype="Number" />
        {{else}}
        {{#if system.spellcasting.hideCharges}}
        <input type="text" class="spells" name="system.spellcasting.charges.value" value="***" readonly/>
        {{else}}
        <input type="text" class="spells" name="system.spellcasting.charges.value" value="{{system.spellcasting.charges.value}}" readonly/>
        /
        <input type="text" class="spells" name="system.spellcasting.charges.max" value="{{system.spellcasting.charges.max}}" readonly/>
        {{/if}}
        {{/if}}
        <span class="spells-label">({{localize "HYP3E.dataLabel.leaveBlank"}})</span>
      </div>
    </div>

    {{!-- Spells appear here --}}
    <ul class="items-list item-spells">
        <li class="item flexrow items-header">
            <div class="item-name">{{localize 'HYP3E.item.spellsAbilities'}}</div>
            <div class="item-prop">{{localize 'HYP3E.item.charges'}}</div>
            <div class="item-prop">{{localize 'HYP3E.details.level'}}</div>
            <div class="item-prop">{{localize 'HYP3E.dataLabel.viewRemove'}}</div>
        </li>
        {{#each spells as |entry idx|}}
        <li class="item-entry item spell-entry" data-index="{{idx}}" data-spell-id="{{entry.spell.uuid}}" draggable="true">
            <div class="item-header flexrow">
                <div class="item-name">
                    <div class="item-image">
                        <img src="{{entry.spell.img}}" title="{{entry.spell.name}}" width="24" height="24"/>
                    </div>
                    <a><h4 class="item-drop">{{entry.spell.name}}</h4></a>
                </div>
                <div class="item-prop">
                    <input type="hidden"
                        name="system.spellcasting.spellRefs.{{idx}}.uuid"
                        value="{{entry.uuid}}" />
                    <input type="number" class="spells" 
                        name="system.spellcasting.spellRefs.{{idx}}.charges" 
                        value="{{entry.charges}}" 
                        data-dtype="Number"
                        {{#unless @root.isGM}}readonly{{/unless}}
                    />
                </div>
                <div class="item-prop">{{entry.spell.system.spellLevel}}</div>
                <div class="item-controls">
                    <a class="item-control item-show" title='{{localize "HYP3E.item.show"}}'><i class="fas fa-eye"></i></a>
                    <a class="item-control item-delete-spell" title="{{localize 'HYP3E.item.delete'}}"><i class="fas fa-trash"></i></a>
                </div>
            </div>
            <div class="item-summary">
                <div class="item-description">
                    {{{entry.spell.system.description}}}
                </div>
            </div>
        </li>
        {{/each}}
    </ul>
  </section>
</section>
