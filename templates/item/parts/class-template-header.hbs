      <div class="flexrow">
        <div class="resource flexrow flex-group-center">
          <span class="flex-item">
            <input type="text" name="system.hitDie" value="{{system.hitDie}}" placeholder="e.g., 1d8" /><br />
            <label for="system.hitDie" title="{{localize 'HYP3E.classEditor.hitDieNote'}}">{{localize 'HYP3E.details.hitDie'}}</label>
          </span>
        </div>
        <div class="resource flexrow flex-group-center">
          <span class="flex-item">
            <select name="system.baseClass">
              <option value=""></option>
              {{selectOptions baseClasses selected=system.baseClass localize=false}}
            </select><br />
            <label for="system.baseClass" title="{{localize 'HYP3E.classEditor.baseClassNote'}}">{{localize 'HYP3E.classEditor.baseClass'}}</label>
          </span>
        </div>
        <div class="resource flexrow flex-group-center">
          <div class="spellcaster-switch">
            <label class="switch">
              <input type="checkbox" class="spellcaster-toggle" 
                data-action="toggleSpells" 
                data-value="{{system.spellcaster}}" 
                {{#if system.spellcaster}}checked{{/if}}
              >
              <div class="slider round"></div>
            </label>
            <label class="header-label-small">
              {{#if system.spellcaster}}{{localize "HYP3E.dataLabel.spellcaster"}}
              {{else}}{{localize "HYP3E.dataLabel.noSpells"}}
              {{/if}}
            </label>
          </div>
        </div>
      </div>