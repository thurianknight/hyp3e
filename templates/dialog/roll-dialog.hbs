<form>
    <div class="hyp3e roll-dialog">
        {{#if dataset.details}}
        <div class="roll-details">
            {{dataset.details}}
        </div>
        {{/if}}
        <div class="flexrow form-group">
            <label class="dialog-label">{{localize "HYP3E.rollFormula"}}</label>
            <input type="text" name="baseRollFormula" value="{{dataset.roll}}" disabled />
        </div>
        {{#if dataset.combatOptionsList}}
        <div class="flexrow form-group">
            <label class="dialog-label">{{localize "HYP3E.dataLabel.combatOptions"}}</label>
            <span style="font-style: italic; padding: 5px 0; display: inline-flex; align-items: center;">{{dataset.combatOptionsList}}</span>
        </div>
        {{/if}}
        {{!-- {{#unless dataset.noRoll}} --}}
        <div class="flexrow form-group">
            <label class="dialog-label">{{localize "HYP3E.sitMod"}}</label>
            <input type="text" name="sitMod" value="{{dataset.sitMod}}" placeholder="{{localize 'HYP3E.rollExample'}}" />
        </div>
        {{#if dataset.sitModList}}
        <div class="flexrow form-group" style="padding-left: 15px;">
            <span style="font-style: italic; padding-bottom: 5px; display: inline-flex; align-items: center;">{{dataset.sitModList}}</span>
        </div>
        {{/if}}
        {{!-- {{/unless}} --}}
        {{#if dataset.showAmmo}}
        <div class="flexrow form-group">
            <label class="dialog-label">{{localize 'HYP3E.item.ammunition'}}</label>
            <select name="ammunition">
                {{selectOptions ammoTypes selected=selectedAmmo localize=true}}
            </select>
        </div>
        {{/if}}
        {{#if dataset.showRanges}}
        <div class="flexrow form-group">
            <label class="dialog-label">{{localize 'HYP3E.weapon.range'}}: {{dataset.rangeText}}
              {{#if (eq dataset.isOutdoor true)}}<i>(outdoors)</i> {{/if}}
            </label>
            <div class="form-fields">
                {{radioBoxes rangeGroup ranges checked=chosen localize=true}}
            </div>
        </div>
        {{/if}}
        {{#if dataset.showSpellRange}}
        <div class="flexrow form-group">
            <label class="dialog-label">{{localize 'HYP3E.weapon.range'}}: {{dataset.rangeText}}</label>
            <div class="form-fields">
                <input type="text" name="spellRange" value="{{localize 'HYP3E.spell.spellRange'}}: {{dataset.spellRange}}" disabled />
            </div>
        </div>
        {{/if}}
        {{!-- {{#unless dataset.noRoll}} --}}
        <div class="flexrow form-group">
            <label class="dialog-label">{{localize "HYP3E.rollMode"}}</label>
            <select name="rollMode">
                {{selectOptions rollModes selected=rollMode localize=true}}
            </select>
        </div>
        {{!-- {{/unless}} --}}
    </div>
</form>