  {{!-- Sheet Header --}}
  <header class="sheet-header merchant">
    <div class="header-bg"></div>
    <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-block">
      <div class="npc-header-block flexcol">
        <div class="npc-header-block flexrow">
          <h2 class="charname">
            <input name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
          </h2>
        </div>
        <div class="npc-header-block flexrow">
          {{#if isGM}}
          <div class="npc-header-block">
            <div class="money-block flexrow">
              {{#each system.money as |coin key|}}
              <div class="ability align-center">
                <label for="system.money.{{key}}.value" class="exploration-label">{{coin.label}}</label>
                <input type="text" name="system.money.{{key}}.value" value="{{coin.value}}" />
              </div>
              {{/each}}
            </div>
            <div class="money-block align-left">
              <input type="checkbox" name="system.ignoreQty" {{checked system.ignoreQty}} />
              <label for="system.ignoreQty" class="small-label">{{localize 'Ignore merchant qty'}}</label>
            </div>
          </div>
          <div class="npc-header-block">
            <div class="money-block align-center">
              <input type="number" step="0.1" name="system.sellMultiplier" value="{{system.sellMultiplier}}" />
              <label for="system.sellMultiplier" class="small-label">{{localize 'HYP3E.dataLabel.sellMultiplier'}}</label>
            </div>
            <div class="money-block align-center">
              <input type="number" step="0.1" name="system.buyMultiplier" value="{{system.buyMultiplier}}" />
              <label for="system.buyMultiplier" class="small-label">{{localize 'HYP3E.dataLabel.buyMultiplier'}}</label>
            </div>
          </div>
          {{/if}}
        </div>
      </div>
    </div>
  </header>