  {{!-- Sheet Header --}}
  <header class="sheet-header npc">
    <div class="header-bg"></div>
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-block">
      <div class="npc-header-block flexcol">
        <div class="npc-header-block flexrow">
            <h2 class="charname">
                <input name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
            </h2>
            <span class="npc-header-block">
                <label for="system.tokenAlias" class="small-label">{{localize "HYP3E.tokenAlias"}}</label>
                <input type="text" name="system.tokenAlias" value="{{system.tokenAlias}}"/>
            </span>
        </div>
        <div class="npc-header-block flexrow">
          <div class="npc-field align-center">
            <select name="system.size">
              <option value=""></option>
              {{selectOptions creatureSizes selected=system.size localize=false}}
            </select><br/>
            <label for="system.size" class="small-label">{{localize 'HYP3E.size'}}</label>
          </div>
          <div class="npc-field align-center">
            <input type="text" name="system.alignment" value="{{system.alignment}}" />
            <label for="system.alignment" class="small-label">{{localize 'HYP3E.alignment'}}</label>
          </div>
          <div class="npc-field align-center">
            <input type="text" name="system.encWild" value="{{system.encWild}}" />
            <label for="system.encWild" class="small-label">{{localize 'HYP3E.encWild'}}</label>
          </div>
          <div class="npc-field align-center">
            <input type="text" name="system.encLair" value="{{system.encLair}}" />
            <label for="system.encLair" class="small-label">{{localize 'HYP3E.encLair'}}</label>
          </div>
        </div>
        <div class="npc-header-block flexrow">
          <div class="npc-field align-center">
            <select name="system.phenotype">
              <option value=""></option>
              {{selectOptions phenotypes selected=system.phenotype localize=false}}
            </select><br/>
            <label for="system.phenotype" class="small-label">{{localize 'HYP3E.phenotype'}}</label>
          </div>
          <div class="npc-field align-center">
            <input type="text" name="system.morale" value="{{system.morale}}" data-dtype="Number" />
            <a class="rollable small-label" 
                data-action="rollThis" 
                data-roll="2d6" 
                data-roll-type="check" 
                data-roll-target="{{system.morale}}" 
                data-label="{{localize 'HYP3E.morale'}}">
                    {{localize 'HYP3E.morale'}} 
              <i class="fas fa-dice"></i>
            </a>
          </div>
          <div class="npc-field align-center">
            <input type="text" name="system.xp" value="{{system.xp}}" />
            <label for="system.xp" class="small-label">{{localize 'HYP3E.xp'}}</label>
          </div>
          <div class="npc-field align-center">
            <input type="text" name="system.treasure" value="{{system.treasure}}" />
            <label for="system.treasure" class="small-label">{{localize 'HYP3E.treasure'}}</label>
          </div>
        </div>
      </div>
    </div>
  </header>