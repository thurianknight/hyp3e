  {{!-- Sheet Header --}}
  <header class="sheet-header itemToken">
    <div class="header-bg"></div>
    <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-block">
      <div class="npc-header-block flexcol">
        <div class="npc-header-block flexrow">
          <h2 class="charname">
            <input name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
          </h2>
        </div>
        <div class="npc-header-block align-left">
          <div class="npc-field">
            <label for="system.size" class="small-label" style="margin-right: 10px;">{{localize 'HYP3E.size'}}</label> 
            <select name="system.size" style="width: auto;">
              <option value=""></option>
              {{selectOptions creatureSizes selected=system.size localize=false}}
            </select>
          </div>
        </div>
      </div>
    </div>
  </header>