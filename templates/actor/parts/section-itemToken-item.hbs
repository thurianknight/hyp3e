{{!-- The item as a weapon, if it is one, appears here --}}
{{#each weapons as |item id|}}
<ol class="items-list" data-drop="item">
  <li class="item flexrow items-header">
    <h3 class="item-name">{{localize 'HYP3E.headers.linkedWeapon'}}</h3>
    <h3>{{localize 'HYP3E.headers.atkRate'}}</h3>
    <h3>{{localize 'HYP3E.headers.damage'}}</h3>
    <h4 class="item-controls">&nbsp;</h4>
  </li>
    <li class="item-entry item draggable" data-item-id="{{item.id}}">
      <div class="flexrow">
        <div class="item-name">
          <div class="item-image">
            <a class="rollable" 
                data-action="rollThis" 
                data-roll-type="item" 
                data-label="Attack with {{item.name}}">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
            </a>
          </div>
          <div class="item-prop">{{item.name}}</div>
        </div>
        <div class="item-prop">{{item.system.rof}}</div>
        <div class="item-prop">{{item.system.damage}}</div>
        <div class="item-controls">
          <a data-action="displayItem" 
              title='{{localize "HYP3E.item.show"}}'>
            <i class="fas fa-eye"></i>
          </a>
          <a data-action="editItem" 
              title="{{localize 'HYP3E.item.edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          {{!-- <a data-action="deleteItem" 
              title="Delete Item">
            <i class="fas fa-trash"></i>
          </a> --}}
        </div>
      </div>
    </li>
</ol>
{{/each}}

{{!-- If the item is an ordinary item, it appears here --}}
{{#each gear as |item id|}}
<ol class="items-list" data-drop="item">
  <li class="item flexrow items-header">
    <h3 class="item-name">{{localize 'HYP3E.headers.linkedItem'}}</h3>
    <h3>{{localize 'HYP3E.item.weight'}}</h3>
    <h4 class="item-controls">&nbsp;</h4>
  </li>
    <li class="item-entry item draggable" data-item-id="{{item.id}}">
      <div class="flexrow">
        <div class="item-name">
          <div class="item-image">
            {{#if (or item.system.formula item.effects.size)}}
            <a class="rollable" 
                data-action="rollThis" 
                data-roll-type="item" 
                data-label="{{localize 'HYP3E.dataLabel.use'}} {{item.name}}">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
            </a>
            {{else}}
            <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
            {{/if}}
          </div>
          <div class="item-prop">{{item.name}}</div>
        </div>
        <div class="item-prop">{{item.system.weight}}</div>
        <div class="item-controls">
          <a data-action="displayItem" 
              title='{{localize "HYP3E.item.show"}}'>
            <i class="fas fa-eye"></i>
          </a>
          <a data-action="editItem" 
              title="{{localize 'HYP3E.item.edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          {{!-- <a data-action="deleteItem" 
              title="Delete Item">
            <i class="fas fa-trash"></i>
          </a> --}}
        </div>
      </div>
    </li>
</ol>
{{/each}}
