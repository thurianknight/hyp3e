<section 
    class="tab {{tabs.items.cssClass}}"
    data-tab="{{tabs.items.id}}"
    data-group="primary"
>
{{#if (eq actor.type "character")}}
  <section class="all-content">
    <section class="left-gutter">
        <img src="systems/hyp3e/assets/serpent-spear.png">
    </section>
    <section class="main-content">
        {{!-- Inventory --}}
        <h2>{{localize 'HYP3E.headers.equipmentItems'}}</h2>
        <ol class="items-list" data-drop="item">
            <li class="item flexrow items-header">
                <div class="item-name">{{localize "HYP3E.headers.items"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.qty"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.weight"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.value"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.location"}}</div>
                <div class="item-controls">
                    <a class="item-control item-create" 
                        data-action="createItem" 
                        data-type="item">
                      <i class="fas fa-plus"></i> {{localize "HYP3E.item.add"}}
                    </a>
                </div>
            </li>
            {{!-- Container items --}}
            {{#each containers as |container id|}}
                <li class="item-entry item-container item draggable" data-item-id="{{container.id}}">
                    <div class="item-header flexrow">
                        <div class="item-name">
                            <div class="item-image">
                                {{#if (or container.system.formula container.effects.size)}}
                                <a class="rollable" 
                                    data-action="rollThis" 
                                    data-item-id="{{container.id}}" 
                                    data-roll-type="item" 
                                    data-label="{{localize 'HYP3E.dataLabel.use'}} {{container.name}}">
                                  <img src="{{container.img}}" title="{{container.name}}" width="24" height="24"/>
                                </a>
                                {{else}}
                                <img src="{{container.img}}" title="{{container.name}}" width="24" height="24"/>
                                {{/if}}
                            </div>
                            {{#if container.system.identified}}
                            <!-- Cast spell button (only shown if item has spells) -->
                            {{#if container.system.spellcasting.spellRefs.length}}
                            <div class="item-prop" style="margin-right: 5px;">
                                <a class="item-cast-spell" 
                                    data-action="itemCastSpell" 
                                    data-roll-mode="publicroll" 
                                    title="{{localize 'HYP3E.item.castSpell'}}">
                                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                                </a>
                            </div>
                            {{/if}}
                            {{!-- Toggle light button (only if item name is in the lightSources table) --}}
                            {{#if container.system.isLightSource}}
                            <div class="item-prop" style="margin-right: 5px;">
                                <a class="item-toggle-light" 
                                    data-action="itemToggleLight" 
                                    title='{{localize "HYP3E.item.toggleLight"}}'>
                                  <i class="fa-solid fa-lightbulb"></i>
                                </a>
                            </div>
                            {{/if}}
                            {{/if}}
                            <a data-action="dropItemDescription"><span class="item-drop">{{container.name}}</span></a>
                        </div>
                        <div class="item-prop">{{container.system.quantity.value}}
                            {{#if container.system.quantity.max}}
                                / {{container.system.quantity.max}}
                            {{/if}}
                        </div>
                        <div class="item-prop">{{container.system.carriedWt}}</div>
                        <div class="item-prop">{{container.system.value}}</div>
                        <div class="item-prop">{{container.system.location}}</div>
                        <div class="item-controls">
                            <a class="item-control item-equip {{#unless container.system.equipped}}item-unequipped{{/unless}}" 
                                data-action="toggleItemEquip" 
                                title='{{localize "HYP3E.item.carry"}}'>
                              <i class="fas fa-sack"></i>
                            </a>
                            <a class="item-control item-show" 
                                data-action="displayItem" 
                                title='{{localize "HYP3E.item.show"}}'>
                              <i class="fas fa-eye"></i>
                            </a>
                            <a class="item-control item-edit" 
                                data-action="editItem" 
                                title="{{localize 'HYP3E.item.edit'}}">
                              <i class="fas fa-edit"></i>
                            </a>
                            <a class="item-control item-delete" 
                                data-action="deleteItem" 
                                title="{{localize 'HYP3E.item.delete'}}">
                              <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                    <div class="item-summary">
                        <div class="item-description">
                            {{{container.system.enrichedDescription}}}
                        </div>
                    </div>
                </li>
                {{!-- Items in a container --}}
                <ol class="items-list" data-drop="item">
                    {{#each container.contents as |item id|}}
                    <li class="item-entry item draggable" data-item-id="{{item.id}}">
                        <div class="item-header flexrow">
                            <div class="item-name contained-items">
                                <div class="item-image">
                                    {{#if (or item.system.formula item.effects.size)}}
                                    <a class="rollable" 
                                        data-action="rollThis" 
                                        data-item-id="{{item.id}}" 
                                        data-roll-type="item" 
                                        data-label="{{localize 'HYP3E.dataLabel.use'}} {{item.name}}">
                                      <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                                    </a>
                                    {{else}}
                                    <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                                    {{/if}}
                                </div>
                                {{#if item.system.identified}}
                                <!-- Cast spell button (only shown if item has spells) -->
                                {{#if item.system.spellcasting.spellRefs.length}}
                                <div class="item-prop" style="margin-right: 5px;">
                                    <a class="item-cast-spell" 
                                        data-action="itemCastSpell" 
                                        data-roll-mode="publicroll" 
                                        title="{{localize 'HYP3E.item.castSpell'}}">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    </a>
                                </div>
                                {{/if}}
                                {{!-- Toggle light button (only if item name is in the lightSources table) --}}
                                {{#if item.system.isLightSource}}
                                <div class="item-prop" style="margin-right: 5px;">
                                    <a class="item-toggle-light" 
                                        data-action="itemToggleLight" 
                                        title='{{localize "HYP3E.item.toggleLight"}}'>
                                    <i class="fa-solid fa-lightbulb"></i>
                                    </a>
                                </div>
                                {{/if}}
                                {{/if}}
                                <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
                            </div>
                            <div class="item-prop">
                                {{#if item.system.quantity.max}}
                                <a class="item-control item-qty-sub" 
                                    data-action="itemQtySub" 
                                    title='{{localize "HYP3E.item.decr"}}'>
                                  <i class="fa fa-minus-circle" aria-hidden="true"></i>
                                </a>&nbsp;&nbsp;
                                <a class="item-control item-qty-add" 
                                    data-action="itemQtyAdd" 
                                    title='{{localize "HYP3E.item.incr"}}'>
                                  <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                </a>&nbsp;&nbsp;
                                {{/if}}
                                {{item.system.quantity.value}}
                                {{#if item.system.quantity.max}}
                                / {{item.system.quantity.max}}
                                {{/if}}
                            </div>
                            <div class="item-prop">{{item.system.carriedWt}}</div>
                            <div class="item-prop">{{item.system.value}}</div>
                            <div class="item-prop">{{item.system.location}}</div>
                            <div class="item-controls">
                                <a class="item-control item-equip {{#unless item.system.equipped}}item-unequipped{{/unless}}" 
                                    data-action="toggleItemEquip" 
                                    title='{{localize "HYP3E.item.carry"}}'>
                                <i class="fas fa-sack"></i>
                                </a>
                                <a class="item-control item-show" 
                                    data-action="displayItem" 
                                    title='{{localize "HYP3E.item.show"}}'>
                                <i class="fas fa-eye"></i>
                                </a>
                                <a class="item-control item-edit" 
                                    data-action="editItem" 
                                    title="{{localize 'HYP3E.item.edit'}}">
                                <i class="fas fa-edit"></i>
                                </a>
                                <a class="item-control item-delete" 
                                    data-action="deleteItem" 
                                    title="{{localize 'HYP3E.item.delete'}}">
                                <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </div>
                        <div class="item-summary">
                            <div class="item-description">
                                <div class="contained-items">{{{item.system.enrichedDescription}}}</div>
                            </div>
                        </div>
                    </li>
                    {{/each}}
                </ol>
            {{/each}}
            {{!-- Non-contained and non-container items --}}
            {{#each gear as |item id|}}
                <li class="item-entry item draggable" data-item-id="{{item.id}}">
                    <div class="item-header flexrow">
                        <div class="item-name">
                            <div class="item-image">
                                {{#if (or item.system.formula item.effects.size)}}
                                <a class="rollable" 
                                    data-action="rollThis" 
                                    data-item-id="{{item.id}}" 
                                    data-roll-type="item" 
                                    data-label="{{localize 'HYP3E.dataLabel.use'}} {{item.name}}">
                                  <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                                </a>
                                {{else}}
                                <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                                {{/if}}
                            </div>
                            {{#if item.system.identified}}
                            <!-- Cast spell button (only shown if item has spells) -->
                            {{#if item.system.spellcasting.spellRefs.length}}
                            <div class="item-prop" style="margin-right: 5px;">
                                <a class="item-cast-spell" 
                                    data-action="itemCastSpell" 
                                    data-roll-mode="publicroll" 
                                    title="{{localize 'HYP3E.item.castSpell'}}">
                                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                                </a>
                            </div>
                            {{/if}}
                            {{!-- Toggle light button if item is a light source --}}
                            {{#if item.system.isLightSource}}
                            <div class="item-prop" style="margin-right: 5px;">
                                <a class="item-toggle-light" 
                                    data-action="itemToggleLight" 
                                    title='{{localize "HYP3E.item.toggleLight"}}'>
                                  <i class="fa-solid fa-lightbulb"></i>
                                </a>
                            </div>
                            {{/if}}
                            {{/if}}
                            <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
                        </div>
                        <div class="item-prop">
                            {{#if item.system.isConsumable}}
                            <a class="item-control item-qty-sub" 
                                data-action="itemQtySub" 
                                title='{{localize "HYP3E.item.decr"}}'>
                              <i class="fa fa-minus-circle" aria-hidden="true"></i>
                            </a>&nbsp;&nbsp;
                            <a class="item-control item-qty-add" 
                                data-action="itemQtyAdd" 
                                title='{{localize "HYP3E.item.incr"}}'>
                              <i class="fa fa-plus-circle" aria-hidden="true"></i>
                            </a>&nbsp;&nbsp;
                            {{/if}}
                            {{item.system.quantity.value}}
                            {{#if item.system.isConsumable}}
                                / {{item.system.quantity.max}}
                            {{/if}}
                        </div>
                        <div class="item-prop">{{item.system.carriedWt}}</div>
                        <div class="item-prop">{{item.system.value}}</div>
                        <div class="item-prop">{{item.system.location}}</div>
                        <div class="item-controls">
                            <a class="item-control item-equip {{#unless item.system.equipped}}item-unequipped{{/unless}}" 
                                data-action="toggleItemEquip" 
                                title='{{localize "HYP3E.item.carry"}}'>
                              <i class="fas fa-sack"></i>
                            </a>
                            <a class="item-control item-show" 
                                data-action="displayItem" 
                                title='{{localize "HYP3E.item.show"}}'>
                              <i class="fas fa-eye"></i>
                            </a>
                            <a class="item-control item-edit" 
                                data-action="editItem" 
                                title="{{localize 'HYP3E.item.edit'}}">
                              <i class="fas fa-edit"></i>
                            </a>
                            <a class="item-control item-delete" 
                                data-action="deleteItem" 
                                title="{{localize 'HYP3E.item.delete'}}">
                              <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                    <div class="item-summary">
                        <div class="item-description">
                            {{{item.system.enrichedDescription}}}
                        </div>
                    </div>
                </li>
            {{/each}}
        </ol>
        <div class="money-block flexrow">
            <div class="resource-content flex-group-center">
                <h3>{{localize "HYP3E.headers.encumbrance"}}</h3>
            </div>
            <div class="resource-content flex-group-center">
                <h3>{{localize "HYP3E.headers.money"}}</h3>
            </div>
            <div class="resource-content flex-xlarge flex-group-center">
                <h3>{{localize "HYP3E.headers.treasure"}}</h3>
            </div>
        </div>
        <div class="money-block flexrow">
            <div class="money-block flex-group-center">
                <label for="system.encumbrance" class="exploration-label">Total Carried:</label><br />
                <span>{{encumbrance}} pounds</span>
                {{#if isEncumbered}}
                <br /><span style="color: red;">Encumbered!</span>
                {{/if}}
                {{#if isHeavilyEncumbered}}
                <br /><span style="color: red; font-weight: bold;">Heavily Encumbered!</span>
                {{/if}}
                <hr class="plain-hr" />
                <label for="system.allTheGold" class="exploration-label">Equipment & Items Total Value:</label><br />
                <span>{{allTheGold}}</span>
            </div>
            <div class="money-block flex-group-center">
                {{#each system.money as |coin key|}}
                <div class="ability flexrow flex-group-center">
                    <label for="system.money.{{key}}.value" class="exploration-label">{{coin.label}}</label>
                    <input type="text" name="system.money.{{key}}.value" value="{{coin.value}}" />
                </div>
                {{/each}}
            </div>
            <div class="treasure-box flex-xlarge">
                {{#if editable}}
                <prose-mirror
                    name="system.treasure"
                    button="true"
                    editable="{{editable}}"
                    toggled="false"
                    value="{{system.treasure}}">
                    {{{enrichedTreasure}}}
                </prose-mirror>
                {{else}}
                {{{enrichedTreasure}}}
                {{/if}}
            </div>
        </div>
    </section>
  </section>
{{/if}}
</section>
