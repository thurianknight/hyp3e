<section 
    class="tab {{tabs.spells.cssClass}}"
    data-tab="{{tabs.spells.id}}"
    data-group="primary"
>
  {{#if (eq actor.type "character")}}
  <section class="all-content">
    <section class="left-gutter">
        <img src="systems/hyp3e/assets/serpent-spear.png">
    </section>
    <section class="main-content">
        {{!-- Casting ability --}}
        <h2>{{localize 'HYP3E.tabs.spells'}}</h2>
        <div class="flex-group-left">
            <div class="casting-ability">
                <span class="spells-label">{{localize "HYP3E.castingAbility"}}</span>
                <input type="number" class="spells" name="system.ca" value="{{system.ca}}" />
            </div>
        </div>
        <div class="flexrow">
            <div class="spells-block flex-xlarge">
                <input type="text" class="spell-list" name="system.spellList" value="{{system.spellList}}"/>
                <span class="spells-label">{{localize 'HYP3E.dataLabel.spellsPerDay'}}:</span>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl1'}}</span>
                <input type="text" class="spells" name="system.spells.l1" value="{{system.spells.l1}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl2'}}</span>
                <input type="text" class="spells" name="system.spells.l2" value="{{system.spells.l2}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl3'}}</span>
                <input type="text" class="spells" name="system.spells.l3" value="{{system.spells.l3}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl4'}}</span>
                <input type="text" class="spells" name="system.spells.l4" value="{{system.spells.l4}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl5'}}</span>
                <input type="text" class="spells" name="system.spells.l5" value="{{system.spells.l5}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl6'}}</span>
                <input type="text" class="spells" name="system.spells.l6" value="{{system.spells.l6}}"/>
            </div>
        </div>
        {{#if system.spellList2}}
        <div class="flexrow">
            <div class="spells-block flex-xlarge">
                <input type="text" class="spell-list" style="min-width: 100px" name="system.spellList2" value="{{system.spellList2}}"/>
                <span class="spells-label">{{localize 'HYP3E.dataLabel.spellsPerDay'}}:</span>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl1'}}</span>
                <input type="text" class="spells" name="system.spells2.l1" value="{{system.spells2.l1}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl2'}}</span>
                <input type="text" class="spells" name="system.spells2.l2" value="{{system.spells2.l2}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl3'}}</span>
                <input type="text" class="spells" name="system.spells2.l3" value="{{system.spells2.l3}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl4'}}</span>
                <input type="text" class="spells" name="system.spells2.l4" value="{{system.spells2.l4}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl5'}}</span>
                <input type="text" class="spells" name="system.spells2.l5" value="{{system.spells2.l5}}"/>
            </div>
            <div class="spells-block">
                <span class="spells-label">{{localize 'HYP3E.dataLabel.lvl6'}}</span>
                <input type="text" class="spells" name="system.spells2.l6" value="{{system.spells2.l6}}"/>
            </div>
        </div>      
        {{/if}}

        {{!-- Spells appear here --}}
        <ol class="items-list" data-drop="item">
        {{#each spells as |spells spellLevel|}}
          <li class="flexrow items-header">
            <h3 class="item-name">{{localize 'HYP3E.details.level'}} {{spellLevel}} {{localize 'HYP3E.dataLabel.spells'}} 
              <a class="sort-items" data-action="sortAz" data-item-type="spell" title="Sort Items A-Z">
                <i class="fas fa-sort-alpha-down"></i>
              </a>
            </h3>
            <h3>{{localize 'HYP3E.spell.numMem'}}</h3>
            <h3>{{localize 'HYP3E.weapon.range'}}</h3>
            <h3>{{localize 'HYP3E.spell.duration'}}</h3>
            <h3>{{localize 'HYP3E.spell.save'}}</h3>
            <h4 class="item-controls">
                <a data-action="createItem" 
                    data-type="spell"
                    data-spell-level="{{spellLevel}}">
                  <i class="fas fa-plus"></i> {{localize "HYP3E.spell.addLvl"}} {{spellLevel}}
                </a>
            </h4>
          </li>
          {{#each spells as |item id|}}
          <li class="item-entry item draggable" data-item-id="{{item.id}}">
                <div class="flexrow">
                    <div class="item-name">
                        <div class="item-image">
                            <a class="rollable" 
                                data-action="rollThis" 
                                data-item-id="{{item.id}}" 
                                data-roll-type="item" 
                                data-roll-mode="publicroll" 
                                data-label="{{localize 'HYP3E.dataLabel.castSpell'}} {{item.name}}">
                              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                            </a>
                        </div>
                        <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
                    </div>
                    <div class="item-prop">
                        {{#if item.system.isConsumable}}
                        <a data-action="itemQtySub" 
                            title='{{localize "HYP3E.item.decr"}}'>
                          <i class="fa fa-minus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
                        </a>
                        <a data-action="itemQtyAdd" 
                            title='{{localize "HYP3E.item.incr"}}'>
                          <i class="fa fa-plus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
                        </a>
                        {{/if}}
                        {{item.system.quantity.value}} {{!-- {{item.system.quantity.max}} --}}
                    </div>
                    <div class="item-prop">{{item.system.range}}</div>
                    <div class="item-prop">{{item.system.duration}}</div>
                    <div class="item-prop">{{item.system.save}}</div>
                    <div class="item-controls">
                        <a data-action="displayItem" 
                            title='{{localize "HYP3E.item.show"}}'>
                          <i class="fas fa-eye"></i>
                        </a>
                        <a data-action="editItem" 
                            title="{{localize 'HYP3E.item.edit'}}">
                          <i class="fas fa-edit"></i>
                        </a>
                        <a data-action="deleteItem" 
                            title="{{localize 'HYP3E.item.delete'}}">
                          <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </div>
                <div class="item-summary">
                    <div class="item-description">
                        {{{item.system.enrichedDescription}}}
                    </div>
                </div>
            </li>
            {{/each}}
        {{/each}}
        </ol>
    </section>
  </section>
  {{/if}}
</section>
