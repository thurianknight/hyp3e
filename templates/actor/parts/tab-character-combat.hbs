<section 
    class="tab {{tabs.combat.cssClass}}"
    data-tab="{{tabs.combat.id}}"
    data-group="primary"
>
  {{#if (eq actor.type "character")}}
  <section class="all-content">
    <section class="left-gutter">
        <img src="systems/hyp3e/assets/serpent-spear.png">
    </section>
    <section class="main-content">
      {{!-- Fighting skills and combat statistics --}}
      <section class="combat-block row-top">
        <section class="combat-block fighting-skills flexcol">
            {{!-- Fighting skills and combat statistics --}}
            <div class="resource-content align-center">
                <h2>{{localize "HYP3E.headers.fightingSkills"}}</h2>
            </div>
            <div class="resource-content fighting-ability flexrow flex-group-center">
                <label class="combat-label">{{localize "HYP3E.fightingAbility"}}</label>
                <div>
                  <div class="flexrow fighting-ability">
                    <input type="text" name="system.fightingAbility.value" value="{{system.fightingAbility.value}}" data-dtype="Number" />
                    <input type="text" class="fa-current" name="system.fa" value="{{system.fa}}" data-dtype="Number" disabled/>
                  </div>
                  <span class="mod-label">{{localize 'Base | Current'}}</span>
                </div>
                <label for="system.unskilled" class="combat-label">{{localize "HYP3E.unskilled"}}</label>
                <input type="text" name="system.unskilled" value="{{system.unskilled}}" data-dtype="Number" />
            </div>
            <div class="resource-content class-weapons flexrow">
                <label for="system.proficiencies" class="combat-label-small">{{localize "HYP3E.wpnSkills"}}</label>
                <input type="text" name="system.proficiencies.class" value="{{system.proficiencies.class}}"/>
            </div>
            <div class="resource-content weapon-field flexrow">
                <label for="system.proficiencies" class="combat-label">{{localize "HYP3E.level4"}}</label>
                <input type="text" name="system.proficiencies.lvl4" value="{{system.proficiencies.lvl4}}"/>
            </div>
            <div class="resource-content weapon-field flexrow">
                <label for="system.proficiencies" class="combat-label">{{localize "HYP3E.level8"}}</label>
                <input type="text" name="system.proficiencies.lvl8" value="{{system.proficiencies.lvl8}}"/>
            </div>
            <div class="resource-content weapon-field flexrow">
                <label for="system.proficiencies" class="combat-label">{{localize "HYP3E.level12"}}</label>
                <input type="text" name="system.proficiencies.lvl12" value="{{system.proficiencies.lvl12}}"/>
            </div>
        </section>
        {{!-- Hit Points, Armor Class, Movement --}}
        <section class="combat-block combat-stats flexcol">
            <div class="resource-content align-center">
                <h2>{{localize "HYP3E.headers.combatStats"}}</h2>
            </div>
            {{!-- Divide this section up vertically into 3 parts --}}
            <div class="resource-content flexrow flex-group-center">
                <div class="resource-content hit-points">
                    <div class="flex-between">
                        <label for="system.hp.value" class="combat-label">{{localize "HYP3E.details.hitPoints"}}</label>
                    </div>
                    <div class="flex-between">
                        <input type="text" class="hit-points-current" name="system.hp.value" value="{{system.hp.value}}" data-dtype="Number"/>
                        /
                        <input type="text" name="system.hp.max" value="{{system.hp.max}}" data-dtype="Number"/>
                    </div>
                    <div class="flex-between">
                        <label for="system.hp.tempHp" class="combat-label-smaller">{{localize "HYP3E.details.tempHp"}}</label>
                        <input type="text" class="input-small" name="system.hp.tempHp" value="{{numberFormat system.hp.tempHp sign=true}}" data-dtype="Number"/>
                    </div>
                    <div class="flexrow flex-between">
                        <a class="combat-label rollable" data-action="rollThis" data-roll="{{system.hd}}+{{system.attributes.con.hpMod}}" data-roll-type="basic" data-roll-target="" data-label="{{localize 'HYP3E.dataLabel.hitDieRoll'}}">
                            {{localize "HYP3E.details.hitDie"}} <i class="fas fa-dice-d6"></i>
                        </a>
                        <input type="text" name="system.hd" value="{{system.hd}}" />
                    </div>
                    {{!-- Space to fill --}}
                    <div class="combat-space">
                        <img src="systems/hyp3e/assets/combat_transparent.png">
                    </div>
                </div>
                <div class="resource-content armor-class">
                    <div class="flex-between">
                        <label for="system.ac.value" class="combat-label">{{localize "HYP3E.armor.ac"}}</label>
                        <input type="text" name="system.ac.value" value="{{system.ac.value}}" data-dtype="Number" />
                        <label for="system.ac.tempAcMod" class="combat-label-smaller">Temp AC</label>
                        <input type="text" class="input-small" name="system.ac.tempAcMod" value="{{numberFormat system.ac.tempAcMod sign=true}}" data-dtype="Number"/>
                    </div>
                    <div class="flex-between">
                        <label for="system.ac.dr" class="combat-label">{{localize "HYP3E.armor.dr"}}</label>
                        <input type="text" name="system.ac.dr" value="{{system.ac.dr}}" data-dtype="Number" />
                        <label for="system.ac.tempDrMod" class="combat-label-smaller">Temp DR</label>
                        <input type="text" class="input-small" name="system.ac.tempDrMod" value="{{numberFormat system.ac.tempDrMod sign=true}}" data-dtype="Number"/>
                    </div>
                    <div class="flex-between" style="margin-top: 15px;">
                        <label for="system.movement.base.value" class="combat-label">{{localize "HYP3E.movement.base.abbrev"}}</label>
                        <input type="text" name="system.movement.base.value" value="{{system.movement.base.value}}" data-dtype="Number"/>
                        <label for="system.movement.tempMvMod" class="combat-label-smaller">Temp MV</label>
                        <input type="text" class="input-small" name="system.movement.tempMvMod" value="{{numberFormat system.movement.tempMvMod sign=true}}" data-dtype="Number"/>
                    </div>
                    <div class="flexrow">
                        <span class="flex-xlarge movement-other">
                            <label for="system.otherMv.value" class="combat-label-small">{{localize "HYP3E.otherMv.abbrev"}}</label>
                            <input type="text" name="system.otherMv.value" value="{{system.otherMv.value}}" data-dtype="String"/>
                        </span>
                    </div>
                    <div class="flexrow">
                        {{#if isEncumbered}}
                        <div style="margin-left: 15px; color: red;">Encumbered!</div>
                        {{/if}}
                        {{#if isHeavilyEncumbered}}
                        <div style="margin-left: 15px; color: red; font-weight: bold;">Heavily Encumbered!</div>
                        {{/if}}
                    </div>
                </div>
            </div>
        </section>
      </section>

      {{!-- Saving throws here --}}
      <hr class="plain-hr" />
      <div class="combat-block flexrow">
          {{!-- <div class="resource-content flex-group-center">
            <label for="system.saves.base.value" class="combat-label-smaller">{{localize "HYP3E.saves.base.name"}}</label>
            <input type="text" name="system.saves.base.value" value="{{system.saves.base.value}}" data-dtype="Number" />
          </div> --}}
          <div class="resource-content flex-group-center flex-xlarge">
            <h3>{{localize "HYP3E.headers.savingThrows"}}</h3>
          </div>
          {{!-- <div class="resource-content flex-group-center">
            &nbsp;
          </div> --}}
      </div>
      <div class="saves-block flexrow flex-between">
        <div class="combat-block flex-group-center" style="min-width: 150px;">
            <div class="save-death">
                <div class="save-icon death">
                    <a class="save-icon-button" data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.death.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.deathSave'}}">
                    </a>
                </div>
                <input type="text" name="system.saves.death.value" value="{{system.saves.death.value}}" data-dtype="Number" />
                <input type="text" class="save-current" name="system.saves.death.curr" value="{{system.saves.death.curr}}" data-dtype="Number" disabled />
            </div>
            <div class="save-death">
                <a data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.death.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.deathSave'}}">
                    <i class="fas fa-dice-d20"></i>
                    <span class="saves-label">{{localize "HYP3E.saves.death.name"}}</span>
                </a>
            </div>
        </div>
        <div class="combat-block flex-group-center">
            <div class="save-device">
                <div class="save-icon device">
                    <a class="save-icon-button" data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.device.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.deviceSave'}}">
                    </a>
                </div>
                <input type="text" name="system.saves.device.value" value="{{system.saves.device.value}}" data-dtype="Number" />
                <input type="text" class="save-current" name="system.saves.device.curr" value="{{system.saves.device.curr}}" data-dtype="Number" disabled />
            </div>
            <div class="save-device">
                <a data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.device.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.deviceSave'}}">
                    <i class="fas fa-dice-d20"></i>
                    <span class="saves-label">{{localize "HYP3E.saves.device.name"}}</span>
                </a>
            </div>
        </div>
        <div class="combat-block flex-group-center" style="min-width: 170px;">
            <div class="save-transformation">
                <div class="save-icon transformation">
                    <a class="save-icon-button" data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.transformation.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.xformSave'}}">
                    </a>
                </div>
                <input type="text" name="system.saves.transformation.value" value="{{system.saves.transformation.value}}" data-dtype="Number" />
                <input type="text" class="save-current" name="system.saves.transformation.curr" value="{{system.saves.transformation.curr}}" data-dtype="Number" disabled />
            </div>
            <div class="save-transformation">
                <a data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.transformation.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.xformSave'}}">
                    <i class="fas fa-dice-d20"></i>
                    <span class="saves-label">{{localize "HYP3E.saves.transformation.name"}}</span>
                </a>
            </div>
        </div>
        <div class="combat-block flex-group-center">
            <div class="save-avoidance">
                <div class="save-icon avoidance">
                    <a class="save-icon-button" data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.avoidance.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.avoidanceSave'}}">
                    </a>
                </div>
                <input type="text" name="system.saves.avoidance.value" value="{{system.saves.avoidance.value}}" data-dtype="Number" />
                <input type="text" class="save-current" name="system.saves.avoidance.curr" value="{{system.saves.avoidance.curr}}" data-dtype="Number" disabled />
            </div>
            <div class="save-avoidance">
                <a data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.avoidance.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.avoidanceSave'}}">
                    <i class="fas fa-dice-d20"></i>
                    <span class="saves-label">{{localize "HYP3E.saves.avoidance.name"}}</span>
                </a>
            </div>
        </div>
        <div class="combat-block flex-group-center">
            <div class="save-sorcery">
                <div class="save-icon sorcery">
                    <a class="save-icon-button" data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.sorcery.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.sorcerySave'}}">
                    </a>
                </div>
                <input type="text" name="system.saves.sorcery.value" value="{{system.saves.sorcery.value}}" data-dtype="Number" />
                <input type="text" class="save-current" name="system.saves.sorcery.curr" value="{{system.saves.sorcery.curr}}" data-dtype="Number" disabled />
            </div>
            <div class="save-sorcery">
                <a data-action="rollThis" 
                        data-roll-type="save" 
                        data-roll="1d20" 
                        {{!-- data-roll-mode="publicroll"  --}}
                        data-roll-target="{{system.saves.sorcery.curr}}" 
                        data-label="{{localize 'HYP3E.dataLabel.sorcerySave'}}">
                    <i class="fas fa-dice-d20"></i>
                    <span class="saves-label">{{localize "HYP3E.saves.sorcery.name"}}</span>
                </a>
            </div>
        </div>
      </div>
      <div class="resistances-vulnerabilities">
        <label class="combat-label">{{localize "HYP3E.resistancesAndVulnerabilities"}}:</label> <input type="text" name="system.resistancesVulnerabilities" value="{{system.resistancesVulnerabilities}}" data-dtype="String" />
      </div>

      {{!-- Combat gear here --}}
      <hr class="plain-hr" />
      <div class="combat-block flexrow">
        <div class="resource-content flexrow flex-group-center">
            <h3>{{localize "HYP3E.headers.weaponsAndArmor"}}</h3>
        </div>
      </div>
      {{!-- Weapons --}}
      <ol class="items-list" data-drop="item">
        <li class="flexrow items-header">
            <h3 class="item-name">{{localize "HYP3E.headers.weapons"}}</h3>
            <h3>{{localize "HYP3E.item.qty"}}</h3>
            <h3>{{localize "HYP3E.headers.atkRate"}}</h3>
            <h3>{{localize "HYP3E.headers.classRange"}}</h3>
            <h4 class="item-controls">
                <a data-action="createItem" 
                    data-type="weapon">
                  <i class="fas fa-plus"></i> {{localize "HYP3E.weapon.add"}}
                </a>
            </h4>
        </li>
        {{#each weapons as |item id|}}
        <li class="item-entry item draggable" data-item-id="{{item.id}}">
            <div class="flexrow">
                <div class="item-name">
                    <div class="item-image">
                        <a class="rollable" 
                            data-action="rollThis" 
                            data-item-id="{{item.id}}" 
                            data-roll-type="item" 
                            {{!-- data-roll-mode="publicroll"  --}}
                            data-label="{{localize 'HYP3E.dataLabel.attackWith'}} {{item.name}}">
                          <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                        </a>
                    </div>
                    {{#if item.system.identified}}
                        <!-- Cast spell button (only shown if item has spells) -->
                        {{#if item.system.spellcasting.spellRefs.length}}
                        <div class="item-prop" style="margin-right: 5px;">
                            <a class="item-cast-spell" 
                                data-action="itemCastSpell" 
                                {{!-- data-roll-mode="publicroll" --}}
                                title="{{localize 'HYP3E.item.castSpell'}}">
                              <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </a>
                        </div>
                        {{/if}}
                        {{!-- Toggle light button if item is a light source --}}
                        {{#if item.system.isLightSource}}
                        <div class="item-prop" style="margin-right: 5px;">
                            <a class="item-toggle-light" 
                                data-action="itemToggleLight" 
                                title="{{localize 'HYP3E.item.toggleLight'}}">
                              <i class="fa-solid fa-lightbulb"></i>
                            </a>
                        </div>
                        {{/if}}
                    {{/if}}
                    <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
                </div>
                <div class="item-prop">
                    {{#if item.system.isConsumable}}
                    <a data-action="itemQtySub" 
                        title='{{localize "HYP3E.item.decr"}}'>
                      <i class="fa fa-minus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
                    </a>
                    <a data-action="itemQtyAdd" 
                        title='{{localize "HYP3E.item.incr"}}'>
                      <i class="fa fa-plus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
                    </a>
                    {{/if}}
                    {{item.system.quantity.value}}
                    {{#if item.system.isConsumable}}
                    / {{item.system.quantity.max}}
                    {{/if}}
                </div>
                <div class="item-prop">{{item.system.rof}}</div>
                {{#if item.system.melee}}
                <div class="item-prop">{{item.system.wc}}</div>
                {{else}}
                <div class="item-prop">{{item.system.range.short}}/{{item.system.range.medium}}/{{item.system.range.long}}</div>
                {{/if}}
                <div class="item-controls">
                    <a {{#unless item.system.equipped}}class="item-unequipped"{{/unless}}
                        data-action="toggleItemEquip" 
                        title='{{localize "HYP3E.item.equip"}}'>
                      <i class="fas fa-hand-fist"></i>
                    </a>
                    <a data-action="displayItem" 
                        title='{{localize "HYP3E.item.show"}}'>
                      <i class="fas fa-eye"></i>
                    </a>
                    {{!-- <a data-action="rollDamage" 
                        title='{{localize "HYP3E.item.rollDamage"}}'>
                      <i class="fas fa-sword"></i>
                    </a> --}}
                    <a data-action="editItem" 
                        title="{{localize 'HYP3E.item.edit'}}">
                      <i class="fas fa-edit"></i>
                    </a>
                    <a data-action="deleteItem" 
                        title="{{localize 'HYP3E.item.delete'}}">
                      <i class="fas fa-trash"></i>
                    </a>
                </div>
            </div>
            <div class="item-summary">
                <div class="item-description">
                    <div>{{{item.system.enrichedDescription}}}</div>
                </div>
            </div>
        </li>
        {{/each}}
      </ol>
      {{!-- Ammunition --}}
      <ol class="items-list" data-drop="item">
        <li class="flexrow items-header">
            <h3 class="item-name">{{localize "HYP3E.item.ammunition"}}</h3>
            <h3>{{localize "HYP3E.item.qty"}}</h3>
            <h3></h3>
            <h3></h3>
            <h4 class="item-controls">
                <a data-action="createItem"
                    data-type="item"
                    data-is-ammunition="true"
                    data-is-consumable="true">
                  <i class="fas fa-plus"></i> {{localize "HYP3E.item.addAmmo"}}
                </a>
            </h4>
        </li>
        {{#each items as |item id|}}
            {{#if item.system.isAmmunition}}
            <li class="item-entry item draggable" data-item-id="{{item.id}}">
                <div class="flexrow">
                    <div class="item-name">
                        <div class="item-image">
                            <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                        </div>
                        <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
                    </div>
                    <div class="item-prop">
                        {{#if item.system.isConsumable}}
                        <a data-action="itemQtySub" 
                            title='{{localize "HYP3E.item.decr"}}'>
                          <i class="fa fa-minus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
                        </a>
                        <a data-action="itemQtyAdd" 
                            title='{{localize "HYP3E.item.incr"}}'>
                          <i class="fa fa-plus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
                        </a>
                        {{/if}}
                        {{item.system.quantity.value}}
                        {{#if item.system.isConsumable}}
                        / {{item.system.quantity.max}}
                        {{/if}}
                    </div>
                    <div></div>
                    <div></div>
                    <div class="item-controls">
                        <a data-action="displayItem" 
                            title='{{localize "HYP3E.item.show"}}'>
                          <i class="fas fa-eye"></i>
                        </a>
                        <a data-action="editItem" 
                            title="{{localize 'HYP3E.item.edit'}}">
                          <i class="fas fa-edit"></i>
                        </a>
                        <a data-action="deleteItem" 
                            title="{{localize 'HYP3E.item.delete'}}">
                          <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </div>
                <div class="item-summary">
                    <div class="item-description">
                        <div class="contained-items">{{{item.system.description}}}</div>
                    </div>
                </div>
            </li>
            {{/if}}
        {{/each}}
      </ol>
      {{!-- Armors & shields --}}
      <ol class="items-list" data-drop="item">
        <li class="flexrow items-header">
            <h3 class="item-name">{{localize "HYP3E.headers.armorAndShields"}}</h3>
            <h3>{{localize "HYP3E.armor.ac"}}</h3>
            <h3>{{localize "HYP3E.armor.dr"}}</h3>
            <h3>{{localize "HYP3E.movement.base.abbrev"}}</h3>
            <h4 class="item-controls">
                <a data-action="createItem" 
                    data-type="armor">
                  <i class="fas fa-plus"></i> {{localize "HYP3E.armor.add"}}
                </a>
            </h4>
        </li>
        {{#each armor as |item id|}}
            <li class="item-entry item draggable" data-item-id="{{item.id}}">
                <div class="flexrow">
                    <div class="item-name">
                        <div class="item-image">
                            <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                        </div>
                        {{#if item.system.identified}}
                        <!-- Cast spell button (only shown if item has spells) -->
                        {{#if item.system.spellcasting.spellRefs.length}}
                        <div class="item-prop" style="margin-right: 5px;">
                            <a class="item-cast-spell" 
                                data-action="itemCastSpell"
                                {{!-- data-roll-mode="publicroll"  --}}
                                title='{{localize "Use Spell"}}'>
                              <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </a>
                        </div>
                        {{/if}}
                        {{!-- Toggle light button if item is a light source --}}
                        {{#if item.system.isLightSource}}
                        <div class="item-prop" style="margin-right: 5px;">
                            <a class="item-toggle-light" 
                                data-action="itemToggleLight" 
                                title='{{localize "HYP3E.item.toggleLight"}}'>
                              <i class="fa-solid fa-lightbulb"></i>
                            </a>
                        </div>
                        {{/if}}
                        {{/if}}
                        <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
                    </div>
                    <div class="item-prop">
                        {{#if item.system.identified}}
                        {{item.system.ac}}
                        {{else}}
                        <i>??</i>
                        {{/if}}
                    </div>
                    <div class="item-prop">
                        {{#if item.system.identified}}
                        {{item.system.dr}}
                        {{else}}
                        <i>??</i>
                        {{/if}}
                    </div>
                    <div class="item-prop">{{item.system.mv}}</div>
                    <div class="item-controls">
                        <a {{#unless item.system.equipped}}class="item-unequipped"{{/unless}}
                            data-action="toggleItemEquip" 
                            title='{{localize "HYP3E.item.equip"}}'>
                          <i class="fas fa-shirt"></i>
                        </a>
