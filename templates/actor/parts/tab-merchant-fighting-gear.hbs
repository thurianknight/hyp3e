<section 
    class="tab {{tabs.fightingGear.cssClass}}"
    data-tab="{{tabs.fightingGear.id}}"
    data-group="primary"
>
{{#if (eq actor.type "merchant")}}
  <section class="all-content">
    <section class="left-gutter">
        <img src="systems/hyp3e/assets/serpent-spear.png">
    </section>
    <section class="main-content">
        {{!-- Inventory --}}
        <h2>{{localize 'HYP3E.headers.weaponsAndArmor'}}</h2>
        {{!-- Weapons appear here --}}
        <ol class="items-list" data-drop="item">
            <li class="item flexrow items-header">
                <div class="item-name">{{localize "HYP3E.headers.weapons"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.qty"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.weight"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.unitPrice"}}</div>
                <div class="item-controls">
                    <a class="item-control item-create" 
                        data-action="createItem" 
                        data-type="weapon">
                      <i class="fas fa-plus"></i> {{localize "HYP3E.weapon.add"}}
                    </a>
                </div>
            </li>
            {{#each weapons as |item id|}}
                <li class="item-entry item draggable" data-item-id="{{item.id}}">
                    <div class="item-header flexrow">
                        <div class="item-name">
                            <div class="item-image">
                                <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                            </div>
                            <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
                        </div>
                        <div class="item-prop">
                            {{item.system.quantity.value}}
                            {{#if item.system.isConsumable}}
                                / {{item.system.quantity.max}}
                            {{/if}}
                        </div>
                        <div class="item-prop">{{item.system.carriedWt}}</div>
                        <div class="item-prop">{{item.system.unitPrice}}</div>
                        <div class="item-controls">
                            <a class="item-control item-show" 
                                data-action="displayItem" 
                                title='{{localize "HYP3E.item.show"}}'>
                              <i class="fas fa-eye"></i>
                            </a>
                            <a class="item-control item-edit" 
                                data-action="editItem" 
                                title="{{localize 'HYP3E.item.edit'}}">
                              <i class="fas fa-edit"></i>
                            </a>
                            <a class="item-control item-delete" 
                                data-action="deleteItem" 
                                title="{{localize 'HYP3E.item.delete'}}">
                              <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                    <div class="item-summary">
                        <div class="item-description">
                            {{{item.system.enrichedDescription}}}
                        </div>
                    </div>
                </li>
            {{/each}}
        </ol>
        {{!-- Armors appear here --}}
        <ol class="items-list" data-drop="item">
            <li class="item flexrow items-header">
                <div class="item-name">{{localize "HYP3E.headers.armorAndShields"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.qty"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.weight"}}</div>
                <div class="item-prop">{{localize "HYP3E.item.unitPrice"}}</div>
                <div class="item-controls">
                    <a class="item-control item-create" 
                        data-action="createItem" 
                        data-type="armor">
                      <i class="fas fa-plus"></i> {{localize "HYP3E.armor.add"}}
                    </a>
                </div>
            </li>
            {{#each armor as |item id|}}
                <li class="item-entry item draggable" data-item-id="{{item.id}}">
                    <div class="item-header flexrow">
                        <div class="item-name">
                            <div class="item-image">
                                <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                            </div>
                            <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
                        </div>
                        <div class="item-prop">{{item.system.quantity.value}}</div>
                        <div class="item-prop">{{item.system.carriedWt}}</div>
                        <div class="item-prop">{{item.system.unitPrice}}</div>
                        <div class="item-controls">
                            <a class="item-control item-show" 
                                data-action="displayItem" 
                                title='{{localize "HYP3E.item.show"}}'>
                              <i class="fas fa-eye"></i>
                            </a>
                            <a class="item-control item-edit" 
                                data-action="editItem" 
                                title="{{localize 'HYP3E.item.edit'}}">
                              <i class="fas fa-edit"></i>
                            </a>
                            <a class="item-control item-delete" 
                                data-action="deleteItem" 
                                title="{{localize 'HYP3E.item.delete'}}">
                              <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                    <div class="item-summary">
                        <div class="item-description">
                            <div>{{{item.system.enrichedDescription}}}</div>
                        </div>
                    </div>
                </li>
            {{/each}}
        </ol>
    </section>
  </section>
{{/if}}
</section>
