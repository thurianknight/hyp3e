{{!-- Abilities, and features appear here --}}
<div class="flexrow">
  <div class="flex-xlarge">
    <h3>{{localize 'HYP3E.headers.abilitiesItems'}}</h3>
  </div>
  <div class="align-center">
    <label for="system.encumbrance" class="exploration-label">Wt Carried:</label>
  </div>
  <div class="align-center">
    <span>{{encumbrance}} pounds</span>
  </div>
</div>
<ol class="items-list" data-drop="item">
  <li class="flexrow items-header">
    <h3 class="item-name">{{localize 'HYP3E.headers.ability'}}</h3>
    <h3>{{localize 'HYP3E.checkRoll'}}</h3>
    <h3>{{localize 'HYP3E.target'}}</h3>
    <h4 class="item-controls">
      <a data-action="createItem" 
          data-type="feature">
        <i class="fas fa-plus"></i> {{localize "HYP3E.feature.add"}}
      </a>
    </h4>
  </li>
  {{#each features as |item id|}}
    <li class="item-entry item draggable" data-item-id="{{item.id}}">
      <div class="flexrow">
        <div class="item-name">
          <div class="item-image">
            {{#if (or item.system.formula item.effects.size)}}
            <a class="rollable" 
                data-action="rollThis" 
                data-roll-type="item" 
                data-label="{{item.name}} check">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
            </a>
            {{else}}
            <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
            {{/if}}
          </div>
          <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
        </div>
        <div class="item-prop">{{item.system.formula}}</div>
        <div class="item-prop">{{item.system.tn}}</div>
        <div class="item-controls">
          <a data-action="displayItem" 
              title='{{localize "HYP3E.item.show"}}'>
            <i class="fas fa-eye"></i>
          </a>
          <a data-action="editItem" 
              title="{{localize 'HYP3E.item.edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          <a data-action="deleteItem" 
              title="Delete Item">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </div>
      <div class="item-summary">
        <div class="item-description">
          {{{item.system.enrichedDescription}}}
        </div>
      </div>
    </li>
  {{/each}}
</ol>

{{!-- Natural attacks and weapons appear here --}}
<ol class="items-list" data-drop="item">
  <li class="item flexrow items-header">
    <h3 class="item-name">{{localize 'HYP3E.headers.attacksWeapons'}}</h3>
    <h3>{{localize 'HYP3E.headers.atkRate'}}</h3>
    <h3>{{localize 'HYP3E.headers.damage'}}</h3>
    <h4 class="item-controls">
      <a data-action="createItem" 
          data-type="weapon">
        <i class="fas fa-plus"></i> {{localize "HYP3E.attack.add"}}
      </a>
    </h4>
  </li>
  {{#each weapons as |item id|}}
    <li class="item-entry item draggable" data-item-id="{{item.id}}">
      <div class="flexrow">
        <div class="item-name">
          <div class="item-image">
            <a class="rollable" 
                data-action="rollThis" 
                data-roll-type="item" 
                data-label="Attack with {{item.name}}">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
            </a>
          </div>
          <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
        </div>
        <div class="item-prop">{{item.system.rof}}</div>
        <div class="item-prop">{{item.system.damage}}</div>
        <div class="item-controls">
          <a {{#unless item.system.equipped}}class="item-unequipped"{{/unless}}
              data-action="toggleItemEquip" 
              title='{{localize "HYP3E.item.equip"}}'>
            <i class="fas fa-hand-fist"></i>
          </a>
          <a data-action="displayItem" 
              {{!-- title='{{localize "HYP3E.item.show"}}'>
            <i class="fas fa-eye"></i> --}}
              title='{{localize "HYP3E.item.rollDamage"}}'>
            <i class="fas fa-droplet"></i>
          </a>
          {{!-- <a data-action="rollDamage" 
              title='{{localize "HYP3E.item.rollDamage"}}'>
            <i class="fas fa-sword"></i>
          </a> --}}
          <a data-action="editItem" 
              title="{{localize 'HYP3E.item.edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          <a data-action="deleteItem" 
              title="{{localize 'HYP3E.item.delete'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </div>
      <div class="item-summary">
        <div class="item-description">
          {{{item.system.enrichedDescription}}}
        </div>
      </div>
    </li>
  {{/each}}
</ol>

{{!-- Armor and items appear here --}}
