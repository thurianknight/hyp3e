<ol class="items-list" data-drop="item">
  {{!-- Container items --}}
  {{#each containers as |container id|}}
    <li class="item-entry item-container item draggable" data-item-id="{{container.id}}">
      {{!-- Main item row data --}}
      <div class="flexrow">
        <div class="item-name">
          <div class="item-image">
            {{#if (or container.system.formula container.effects.size)}}
            <a class="rollable" 
                data-action="rollThis" 
                data-item-id="{{container.id}}" 
                data-roll-type="item" 
                data-label="{{localize 'HYP3E.dataLabel.use'}} {{container.name}}">
              <img src="{{container.img}}" title="{{container.name}}" width="24" height="24"/>
            </a>
            {{else}}
            <img src="{{container.img}}" title="{{container.name}}" width="24" height="24"/>
            {{/if}}
          </div>
          {{#if container.system.identified}}
          <!-- Cast spell button (only shown if item has spells) -->
          {{#if container.system.spellcasting.spellRefs.length}}
          <div class="item-prop" style="margin-right: 4px;">
            <a class="item-cast-spell" 
                data-action="itemCastSpell" 
                {{!-- data-roll-mode="publicroll"  --}}
                title="{{localize 'HYP3E.item.castSpell'}}">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
            </a>
          </div>
          {{/if}}
          {{!-- Toggle light button (only if item name is in the lightSources table) --}}
          {{#if container.system.isLightSource}}
          <div class="item-prop" style="margin-right: 4px;">
            <a class="item-toggle-light" 
                data-action="itemToggleLight" 
                title='{{localize "HYP3E.item.toggleLight"}}'>
              <i class="fa-solid fa-lightbulb"></i>
            </a>
          </div>
          {{/if}}
          {{/if}}
          <span class="item-drop"><a data-action="dropItemDescription">{{container.name}}</a></span>
          <a class="item-arrow collapse-toggle" aria-expanded="true">
            ▼
          </a>
        </div>
        <div class="item-prop">
          {{container.system.quantity.value}}
        </div>
        <div class="item-prop">{{container.system.carriedWt}}</div>
        <div class="item-controls">
          <a {{#unless container.system.equipped}}class="item-unequipped"{{/unless}}
              data-action="toggleItemEquip" 
              title='{{localize "HYP3E.item.carry"}}'>
            <i class="fas fa-sack"></i>
          </a>
          <a data-action="displayItem" title='{{localize "HYP3E.item.show"}}'>
            <i class="fas fa-eye"></i>
          </a>
          <a data-action="editItem" title="{{localize 'HYP3E.item.edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          <a data-action="deleteItem" title="{{localize 'HYP3E.item.delete'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </div>
      {{!-- Pop-down item description --}}
      <div class="item-summary">
        <div class="item-description">
          {{{container.system.enrichedDescription}}}
        </div>
      </div>
    </li>
    {{!-- Items in a container --}}
    <div class="container-contents">
      <ol class="items-list" data-drop="item">
        {{#each container.contents as |item id|}}
        <li class="item-entry item draggable" data-item-id="{{item.id}}">
          <div class="flexrow">
            <div class="item-name contained-items">
              <div class="item-image">
                {{#if (or item.system.formula item.effects.size)}}
                <a class="rollable" 
                    data-action="rollThis" 
                    data-item-id="{{item.id}}" 
                    data-roll-type="item" 
                    data-label="{{localize 'HYP3E.dataLabel.use'}} {{item.name}}">
                  <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                </a>
                {{else}}
                <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                {{/if}}
              </div>
              {{#if item.system.identified}}
              <!-- Cast spell button (only shown if item has spells) -->
              {{#if item.system.spellcasting.spellRefs.length}}
              <div class="item-prop" style="margin-right: 4px;">
                <a class="item-cast-spell" 
                    data-action="itemCastSpell" 
                    {{!-- data-roll-mode="publicroll"  --}}
                    title="{{localize 'HYP3E.item.castSpell'}}">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                </a>
              </div>
              {{/if}}
              {{!-- Toggle light button (only if item name is in the lightSources table) --}}
              {{#if item.system.isLightSource}}
              <div class="item-prop" style="margin-right: 4px;">
                <a class="item-toggle-light" 
                    data-action="itemToggleLight" 
                    title='{{localize "HYP3E.item.toggleLight"}}'>
                  <i class="fa-solid fa-lightbulb"></i>
                </a>
              </div>
              {{/if}}
              {{/if}}
              <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
            </div>
            <div class="item-prop">
              {{#if item.system.isConsumable}}
              <a data-action="itemQtySub" title='{{localize "HYP3E.item.decr"}}'>
                <i class="fa fa-minus-circle" aria-hidden="true" style="margin-right: 3px;"></i>
              </a>
              <a data-action="itemQtyAdd" title='{{localize "HYP3E.item.incr"}}'>
                <i class="fa fa-plus-circle" aria-hidden="true" style="margin-right: 3px;"></i>
              </a>
              {{/if}}
              {{item.system.quantity.value}}
              {{#if item.system.isConsumable}}
              / {{item.system.quantity.max}}
              {{/if}}
            </div>
            <div class="item-prop">{{item.system.carriedWt}}</div>
            <div class="item-controls">
              <a {{#unless item.system.equipped}}class="item-unequipped"{{/unless}}
                  data-action="toggleItemEquip" 
                  title='{{localize "HYP3E.item.carry"}}'>
                <i class="fas fa-sack"></i>
              </a>
              <a data-action="displayItem" title='{{localize "HYP3E.item.show"}}'>
                <i class="fas fa-eye"></i>
              </a>
              <a data-action="editItem" title="{{localize 'HYP3E.item.edit'}}">
                <i class="fas fa-edit"></i>
              </a>
              <a data-action="deleteItem" title="{{localize 'HYP3E.item.delete'}}">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          </div>
          <div class="item-summary">
            <div class="item-description">
              <div class="contained-items">{{{item.system.enrichedDescription}}}</div>
            </div>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>
  {{/each}}
  {{#each gear as |item id|}}
    <li class="item-entry item draggable" data-item-id="{{item.id}}">
      <div class="flexrow">
        <div class="item-name">
          <div class="item-image">
            {{#if (or item.system.formula item.effects.size)}}
            <a class="rollable" 
                data-action="rollThis" 
                data-roll-type="item" 
                data-label="{{localize 'HYP3E.dataLabel.use'}} {{item.name}}">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
            </a>
            {{else}}
            <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
            {{/if}}
          </div>
          <!-- Cast spell button (only shown if item has spells) -->
          {{#if item.system.spellcasting.spellRefs.length}}
          <div class="item-prop" style="margin-right: 4px;">
            <a class="item-cast-spell" 
                data-action="itemCastSpell" 
                {{!-- data-roll-mode="publicroll"  --}}
                title="{{localize 'HYP3E.item.castSpell'}}">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
            </a>
          </div>
          {{/if}}
          {{!-- Toggle light button if item is a light source --}}
          {{#if item.system.isLightSource}}
          <div class="item-prop" style="margin-right: 4px;">
            <a class="item-toggle-light" 
                data-action="itemToggleLight" 
                title='{{localize "HYP3E.item.toggleLight"}}'>
              <i class="fa-solid fa-lightbulb"></i>
            </a>
          </div>
          {{/if}}
          <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
        </div>
        <div class="item-prop">
          {{#if item.system.isConsumable}}
            <a data-action="itemQtySub" 
                title='{{localize "HYP3E.item.decr"}}'>
              <i class="fa fa-minus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
            </a>
            <a data-action="itemQtyAdd" 
                title='{{localize "HYP3E.item.incr"}}'>
              <i class="fa fa-plus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
            </a>
          {{/if}}
          {{item.system.quantity.value}}
          {{#if item.system.isConsumable}}
          / {{item.system.quantity.max}}
          {{/if}}
        </div>
        <div class="item-prop">{{item.system.carriedWt}}</div>
        <div class="item-controls">
          <a {{#unless item.system.equipped}}class="item-unequipped"{{/unless}}
              data-action="toggleItemEquip" 
              title='{{localize "HYP3E.item.carry"}}'>
            <i class="fas fa-sack"></i>
          </a>
          <a data-action="displayItem" 
              title='{{localize "HYP3E.item.show"}}'>
            <i class="fas fa-eye"></i>
          </a>
          <a data-action="editItem" 
              title="{{localize 'HYP3E.item.edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          <a data-action="deleteItem" 
              title="{{localize 'HYP3E.item.delete'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </div>
      <div class="item-summary">
        <div class="item-description">
          {{{item.system.enrichedDescription}}}
        </div>
      </div>
    </li>
  {{/each}}
</ol>

{{!-- Spells appear here --}}
{{#if system.ca}}
<h3>{{localize 'HYP3E.dataLabel.spells'}}</h3>
<ol class="items-list" data-drop="item">
  {{#each spells as |spells spellLevel|}}
    <li class="flexrow items-header" data-spell-level="{{@root.actor.id}}{{spellLevel}}">
      <h3 class="item-name">
        <span class="name-expand">{{localize 'HYP3E.details.level'}} {{spellLevel}} {{localize 'HYP3E.dataLabel.spells'}}</span>
        <a class="sort-items" data-action="sortAz" data-item-type="spell" title="Sort Items A-Z">
          <i class="fas fa-sort-alpha-down"></i>
        </a>
        <a class="item-arrow collapse-spells-toggle" aria-expanded="true">
          ▼
        </a>
      </h3>
      <h3>{{localize 'HYP3E.spell.numMem'}}</h3>
      <h3>{{localize 'HYP3E.weapon.range'}}</h3>
      {{!-- <h3>{{localize 'HYP3E.spell.duration'}}</h3> --}}
      <h3>{{localize 'HYP3E.spell.save'}}</h3>
      <h4 class="item-controls">
        <a data-action="createItem" 
            data-type="spell" 
            data-spell-level="{{spellLevel}}">
          <i class="fas fa-plus"></i> {{localize "HYP3E.spell.addLvl"}} {{spellLevel}}
        </a>
      </h4>
    </li>
    <div class="spells-list">
      {{#each spells as |item id|}}
        <li class="item-entry item draggable" data-item-id="{{item.id}}">
          <div class="flexrow">
            <div class="item-name">
              <div class="item-image">
                <a class="rollable" 
                    data-action="rollThis" 
                    data-roll-type="item" 
                    data-label="Cast spell {{item.name}}">
                  <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                </a>
              </div>
              <a data-action="dropItemDescription"><span class="item-drop">{{item.name}}</span></a>
            </div>
            <div class="item-prop">
              {{#if item.system.isConsumable}}
                <a data-action="itemQtySub" 
                    title='{{localize "HYP3E.item.decr"}}'>
                  <i class="fa fa-minus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
                </a>
                <a data-action="itemQtyAdd" 
                    title='{{localize "HYP3E.item.incr"}}'>
                  <i class="fa fa-plus-circle" aria-hidden="true" style="margin-right: 5px;"></i>
                </a>
              {{/if}}
              {{item.system.quantity.value}}
            </div>
            <div class="item-prop">{{item.system.range}}</div>
            {{!-- <div class="item-prop">{{item.system.duration}}</div> --}}
            <div class="item-prop">{{item.system.save}}</div>
            <div class="item-controls">
              {{#if item.system.damage}}
              <a data-action="displayItem" 
                  title='{{localize "HYP3E.item.rollDamage"}}'>
                <i class="fas fa-droplet"></i>
              </a>
              {{else}}
              <a data-action="displayItem" 
                  title='{{localize "HYP3E.item.show"}}'>
                <i class="fas fa-eye"></i>
              </a>
              {{/if}}
              <a data-action="editItem" 
                  title="{{localize 'HYP3E.item.edit'}}">
                <i class="fas fa-edit"></i>
              </a>
              <a data-action="deleteItem" 
                  title="{{localize 'HYP3E.item.delete'}}">
                <i class="fas fa-trash"></i>
              </a>
            </div>
        </div>
        <div class="item-summary">
          <div class="item-description">
            {{{item.system.enrichedDescription}}}
          </div>
        </div>
        </li>
      {{/each}}
    </div>
  {{/each}}
</ol>
{{/if}}