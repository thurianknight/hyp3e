<section class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{#if (eq actor.type "character")}}
    {{> "actor-character-header-v2"}}
  {{/if}}
  {{#if (eq actor.type "npc")}}
    {{> "actor-npc-header-v2"}}
  {{/if}}
  {{#if (eq actor.type "merchant")}}
    {{> "actor-merchant-header-v2"}}
  {{/if}}
  {{#if (eq actor.type "treasure")}}
    {{> "actor-treasure-header-v2"}}
  {{/if}}
  {{#if (eq actor.type "itemToken")}}
    {{> "actor-itemToken-header-v2"}}
  {{/if}}

</section>