<ul class="class-list">
  {{#each classes as |data name|}}
    <li>
        <span class="flex flexrow">
            <span class="class-name">{{name}}</span>
            <button class="edit-class" data-class="{{name}}">Edit</button>
            <button class="delete-class" data-class="{{name}}">Delete</button>
        </span>
    </li>
  {{/each}}
  <li>
    <span class="flex flexrow">
        <span class="class-name">Create New Class</span>
        <button class="new-class">Create</button>
    </span>
  </li>
</ul>
