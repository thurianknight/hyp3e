<ul class="class-list">
  {{#each classes as |data name|}}
    <li>
        <span class="flex flexrow">
            <span class="class-name">{{name}}</span>
            <button class="edit-class" data-class="{{name}}">{{localize 'HYP3E.dataLabel.edit'}}</button>
            <button class="delete-class" data-class="{{name}}">{{localize 'HYP3E.dataLabel.delete'}}</button>
        </span>
    </li>
  {{/each}}
  <li>
    <span class="flex flexrow">
        <span class="class-name">{{localize 'HYP3E.dataLabel.createClass'}}</span>
        <button class="new-class">{{localize 'HYP3E.dataLabel.create'}}</button>
    </span>
  </li>
</ul>
