<section class="class-list">
    <ul class="class-list">
        {{#each classes as |data name|}}
        <li>
            <span class="flex flexrow">
                <span class="class-name">{{name}}</span>
                <button data-action="editClass" data-class="{{name}}">
                    {{localize 'HYP3E.dataLabel.edit'}}
                </button>
                <button data-action="deleteClass" data-class="{{name}}">
                    {{localize 'HYP3E.dataLabel.delete'}}
                </button>
            </span>
        </li>
        {{/each}}
        <li>
            <span class="flex flexrow">
                <span class="class-name">{{localize 'HYP3E.dataLabel.createClass'}}</span>
                <button data-action="newClass"> 
                    {{localize 'HYP3E.dataLabel.create'}}
                </button>
            </span>
        </li>
    </ul>
</section>