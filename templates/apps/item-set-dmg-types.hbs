<div class="item-set-dmg-types">
    <h3>{{item.name}}</h3>
    <input type="hidden" name="itemUuid" value="{{itemUuid}}" />
    <hr class="plain-hr"/>
    <div class="item-set-dmg-types flexrow">
        <span style="font-weight: bold;">Select a Base Type</span>
        <span style="font-weight: bold;">Damage Roll</span>
    </div>
    <div class="form-fields item-set-dmg-types flexrow">
        <select name="dmgType">
            {{selectOptions damageTypes selected=@root.dmgType localize=false}}
        </select>
        <input type="text" name="damage" value="{{@root.damage}}" disabled />
    </div>
    <hr class="plain-hr"/>
    <div class="item-set-dmg-types flexrow">
        <span style="font-weight: bold;">Additional/Alternative Types</span>
        <span style="font-weight: bold;">Damage Roll</span>
    </div>
    <div class="form-fields item-set-dmg-types flexrow">
        <select name="damageType1">
            <option value=""></option>
            {{selectOptions damageTypes selected=@root.damageType1 localize=false}}
        </select>
        <input type="text" name="altDmg1" value="{{@root.altDmg1}}" placeholder="Ex.: 1d4" />
    </div>
    <div class="form-fields item-set-dmg-types flexrow">
        <select name="damageType2">
            <option value=""></option>
            {{selectOptions damageTypes selected=@root.damageType2 localize=false}}
        </select>
        <input type="text" name="altDmg2" value="{{@root.altDmg2}}" placeholder="Ex.: 1d4" />
    </div>
    <div class="form-fields item-set-dmg-types flexrow">
        <select name="damageType3">
            <option value=""></option>
            {{selectOptions damageTypes selected=@root.damageType3 localize=false}}
        </select>
        <input type="text" name="altDmg3" value="{{@root.altDmg3}}" placeholder="Ex.: 1d4" />
    </div>

</div>
