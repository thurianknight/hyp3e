<div class="hyp3e-calendar">
    <div class="calendar-header">
        <div class="flex flexrow">
            <select id="calendar-month">
                {{#each months as |month idx|}}
                <option value="{{idx}}" {{#if (eq ../monthIndex idx)}}selected{{/if}}>
                    {{month.name}}
                </option>
                {{/each}}
            </select> 
            <input id="calendar-year" type="number" value="{{currentYear}}" />
            <span name="year">(Year of the {{year.name}}, <i>{{year.alt}})</i></span>
        </div>
        {{!-- <div class="moon-toggle">
            <label class="switch">
                <input type="checkbox" id="toggle-moon-phases" {{#if showAllMoonPhases}}checked{{/if}}>
                <span class="slider"></span>
            </label>
            <span class="toggle-label">Show all moon phases</span>
        </div> --}}
    </div>

    <table class="calendar-grid">
        <thead>
            <tr>
            {{#each weekdays}}
                <th>{{this}}</th>
            {{/each}}
            </tr>
        </thead>
        <tbody>
            {{#each days}}
            <tr>
                {{#each this}}
                <td class="{{#if isFestival}}festival{{/if}} {{#if isToday}}today{{/if}}" data-day="{{number}}">
                    <div class="day-number">{{number}}</div>
                    <div class="moon-icons">
                      {{#if phobosIcon}}
                      <span class="moon-icon" title="Phobos: {{phobosPhase}}">{{phobosIcon}}</span>
                      {{/if}}
                      {{#if seleneIcon}}
                      <span class="moon-icon" title="Selene: {{selenePhase}}">{{seleneIcon}}</span>
                      {{/if}}
                    </div>
                </td>
                {{/each}}
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="calendar-footer">
        <div class="flex flexrow">
            <div>
                <div class="season-banner">
                    Season: {{season}}
                </div>
            </div>
            <div>
                <div class="moon-legend">
                    <div class="legend-item">Moons Today:</div>
                    <div class="legend-item" title="{{todayPhobos.phase}}">
                        <span class="moon-icon">{{todayPhobos.icon}}</span> Phobos
                    </div>
                    <div class="legend-item" title="{{todaySelene.phase}}">
                        <span class="moon-icon">{{todaySelene.icon}}</span> Selene
                    </div>
                </div>
                <div class="festival-container">
                    {{#if currentFestival}}
                    <div class="festival-banner">
                        Festival: {{currentFestival.name}} (Days {{currentFestival.startDay}}–{{currentFestival.endDay}})
                    </div>
                    {{/if}}
                </div>

            </div>
        </div>
    </div>

    <div class="calendar-footer">
        <div class="flex flexrow">
                <div class="flexrow time-banner">
                    Turn Start Time (H:mm) 
                    <input id="start-time" type="text" value="{{turnStartTime}}" placeholder="ex: 8:00" /> 
                </div>
                <div class="time-banner">
                    Current Time: 
                    <input id="current-time" type="text" value="{{currentTime}}" disabled /> 
                </div>
        </div>
    </div>

    <div class="calendar-toolbar">
        <span class="flexlarge controls-label">Calendar/Turn Controls:</span>
        {{#if isGM}}
        <button type="button" data-action="advance" title="Advance Day"><i class="fas fa-forward-step"></i><i class="fas fa-clock"></i></button>
        {{/if}}
        <button type="button" data-action="chat" title="Send Date to Chat"><i class="fas fa-comment"></i></button>
        {{#if isGM}}
        <button type="button" data-action="advance-reset" title="Advance Day + Reset Turns"><i class="fas fa-clock"></i> + <i class="fas fa-repeat"></i></button>
        <button type="button" data-action="reset" title="Reset Turns"><i class="fas fa-repeat"></i></button>
        {{/if}}
    </div>
</div>