<div class="item-set-base-dmg">
    <label class="resource-label">{{item.name}}</label>
    <input type="hidden" name="itemUuid" value="{{itemUuid}}" />
    <hr class="plain-hr"/>
    <div class="item-set-base-dmg flexrow">
        <label class="resource-label">Select a Base Type</label>
        <label class="resource-label">Damage Roll</label>
    </div>
    <div class="form-fields item-set-base-dmg flexrow">
        <select name="dmgType">
            <option value=""></option>
            {{selectOptions damageTypes selected=@root.dmgType localize=false}}
        </select>
        <input type="text" name="damage" value="{{@root.damage}}" disabled />
    </div>
</div>
