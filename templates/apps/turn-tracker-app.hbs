<div class="flex flexrow turn-tracker">
    <div class="flex flexrow controls">
        <button class="reset" title="Start/Reset"><i class="fas fa-stop"></i></button>
        <button class="advance-turn" title="Advance"><i class="fas fa-forward-step"></i></button>
        <button class="show-turn" title="Show"><i class="fas fa-eye"></i></button>
    </div>
    <div class="flex flexrow controls">
        <h3>Turn: {{currentTurn}}</h3>
    </div>
</div>
