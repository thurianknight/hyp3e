<div class="turn-tracker">
    <div class="controls">
        <button class="open-calendar" title="Open Calendar"><i class="fas fa-calendar-days"></i></button>
        {{!-- <button class="reset" title="Start/Reset"><i class="fas fa-stop"></i></button> --}}
        {{#if isGM}}
        <button class="retreat-turn" title="Retreat Turn"><i class="fas fa-backward-step"></i></button>
        <button class="advance-turn" title="Advance Turn"><i class="fas fa-forward-step"></i></button>
        {{/if}}
        <button class="show-turn" title="Display in Chat"><i class="fas fa-comment"></i></button>
    </div>
    <div class="column-top">
        <div class="controls">
            <span class="turn-label">Turn:</span>
            <input id="current-turn" type="text" value="{{currentTurn}}" disabled />
        </div>
        <div class="controls">
            <span class="time-label">Time:</span>
            <input id="current-time" type="text" value="{{currentTime}}" disabled />
        </div>
    </div>
    <div class="controls">
        {{#if isGM}}
        <button class="open-turn-actions" title="Configure Turn-Advance Actions"><i class="fas fa-cog"></i></button>
        {{/if}}
    </div>
</div>