<form>
  <nav class="tabs" data-group="primary">
    <a class="item" data-tab="ui">UI Options</a>
    <a class="item" data-tab="rules">Rules Options</a>
    <a class="item" data-tab="chars">Character & NPC</a>
    <a class="item" data-tab="tech">Technical</a>
  </nav>

  <section class="content">
    <!-- UI Options -->
    <div class="tab" data-tab="ui">
      <div class="form-group">
        <label>{{localize "HYP3E.settings.calendarVerbose"}}</label>
        <input type="checkbox" name="calendarVerbose" {{checked settings.calendarVerbose}} />
      </div>

      <div class="form-group">
        <label>{{localize "HYP3E.settings.enableTurnTracker"}}</label>
        <input type="checkbox" name="enableTurnTracker" {{checked settings.enableTurnTracker}} />
      </div>

      <div class="form-group">
        <label>{{localize "HYP3E.settings.showWeaponOverlay"}}</label>
        <input type="checkbox" name="showWeaponOverlay" {{checked settings.showWeaponOverlay}} />
      </div>

      <div class="form-group">
        <label>{{localize "HYP3E.settings.resizeTokens"}}</label>
        <input type="checkbox" name="resizeTokens" {{checked settings.resizeTokens}} />
      </div>

    </div>

    <!-- Rules Options -->
    <div class="tab" data-tab="rules">
      <h3>General</h3>
      <div class="form-group">
        <label>{{localize "HYP3E.settings.autoCalcAc"}}</label>
        <input type="checkbox" name="autoCalcAc" {{checked settings.autoCalcAc}} />
      </div>

      <!-- Add the rest of the General + Combat options -->
      <h3>Combat</h3>
      <div class="form-group">
        <label>{{localize "HYP3E.settings.isGroupInitiative"}}</label>
        <input type="checkbox" name="isGroupInitiative" {{checked settings.isGroupInitiative}} />
      </div>

    </div>

    <!-- Character & NPC Options -->
    <div class="tab" data-tab="chars">
      <div class="form-group">
        <label>{{localize "HYP3E.settings.quickCreateChars"}}</label>
        <input type="checkbox" name="quickCreateChars" {{checked settings.quickCreateChars}} />
      </div>

      <div class="form-group">
        <label>{{localize "HYP3E.settings.races"}}</label>
        <textarea name="races"></textarea>
      </div>
      
      <div class="form-group">
        <button type="button" data-action="open-class-manager">Manage Custom Classes</button>
      </div>
    </div>

    <!-- Technical Options -->
    <div class="tab" data-tab="tech">
      <div class="form-group">
        <label>{{localize "HYP3E.settings.logLevel"}}</label>
        <select name="logLevel">
          <option value="0">Verbose (Info, Warnings, Errors)</option>
          <option value="1">Warnings & Errors</option>
          <option value="2">Errors Only</option>
        </select>
      </div>

      <div class="form-group">
        <button type="button" data-action="rerun-migration">Re-run World Migration</button>
      </div>

    </div>
  </section>

  <footer class="sheet-footer flexrow">
    <button type="submit" class="dialog-button">
      <i class="fas fa-save"></i> Save Settings
    </button>
  </footer>
</form>
