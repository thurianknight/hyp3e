{{!-- templates/apps/class-editor.hbs --}}
<form autocomplete="off">
  <fieldset>
    <legend>Class Info</legend>
        <div class="form-group flex flexrow flex-group-center">
            <span class="flex-item">
                <input type="text" name="name" value="{{classKey}}" /><br />
                <label for="name">Class Name</label>
            </span>
            <span class="flex-item">
                <select name="classData.baseClass">
                    <option value=""></option>
                    {{selectOptions baseClasses selected=classData.baseClass localize=false}}
                </select><br />
                <label for="classData.baseClass">Base Class</label>        
            </span>
            <span class="flex-item">
                <input type="text" name="classData.hitDie" value="{{classData.hitDie}}" placeholder="e.g., 1d6, 1d8" /><br />
                <label for="classData.hitDie">Hit Die</label>
            </span>
        </div>
    </legend>
  </fieldset>
  
  <fieldset>
    <legend>Attribute Requirements / Minimums</legend>
      <div class="flex flexrow flex-group-center form-group">
        {{#each attrReqs}}
        <span>
            <input type="number" class="input-small" name="classData.attrReqs.{{@key}}" value="{{this.value}}" /><br />
            <label for="classData.attrReqs.{{@key}}">{{this.label}}</label>
        </span>
        {{/each}}
      </div>
  </fieldset>

  <fieldset>
    <legend>XP Bonus Requirements</legend>
      <div class="flex flexrow flex-group-center form-group">
        {{#each xpBonusReqs}}
        <span>
            <input type="number" class="input-small" name="classData.xpBonusReq.{{@key}}" value="{{this.value}}" /><br />
            <label for="classData.xpBonusReq.{{@key}}">{{this.label}}</label>
        </span>
        {{/each}}
      </div>
  </fieldset>

  <fieldset>
    <legend>Extraordinary Feat Bonus %</legend>
        <div class="flex flexrow flex-group-center form-group">
            <span>
                <input type="number" class="input-small" name="classData.featBonus.str" value="{{classData.featBonus.str}}" /><br />
                <label for="classData.featBonus.str">{{localize 'HYP3E.attributes.str.feat'}}</label>
            </span>
            <span>
                <input type="number" class="input-small" name="classData.featBonus.dex" value="{{classData.featBonus.dex}}" /><br />
                <label for="classData.featBonus.dex">{{localize 'HYP3E.attributes.dex.feat'}}</label>
            </span>
            <span>
                <input type="number" class="input-small" name="classData.featBonus.con" value="{{classData.featBonus.con}}" /><br />
                <label for="classData.featBonus.con">{{localize 'HYP3E.attributes.con.feat'}}</label>
            </span>
        </div>
  </fieldset>

  <fieldset>
    <legend>Save Modifiers</legend>
      <div class="flex flexrow flex-group-center form-group">
        {{#each saves}}
        <span>
            <input type="number" class="input-small" name="classData.saves.{{@key}}" value="{{this.value}}" /><br />
            <label for="classData.saves.{{@key}}">{{this.label}}</label>
        </span>
        {{/each}}
      </div>
  </fieldset>

  <fieldset>
    <legend>Level Advancement</legend>
    <table>
      <thead>
        <tr class="level-advancement">
          <th>Level</th>
          <th>XP</th>
          <th>FA</th>
          <th>CA</th>
          <th>TA</th>
        </tr>
      </thead>
      <tbody>
        {{#each classData.levelAdvancement}}
          <tr class="level-advancement">
            <td>{{@key}}</td>
            <td><input type="number" name="classData.levelAdvancement.{{@key}}.xp" value="{{this.xp}}" /></td>
            <td><input class="input-small" type="number" name="classData.levelAdvancement.{{@key}}.fa" value="{{this.fa}}" /></td>
            <td><input class="input-small" type="number" name="classData.levelAdvancement.{{@key}}.ca" value="{{this.ca}}" /></td>
            <td><input class="input-small" type="number" name="classData.levelAdvancement.{{@key}}.ta" value="{{this.ta}}" /></td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    {{!-- {{#each classData.levelAdvancement}}
      <div class="form-group">
        <label>Level {{@key}} XP</label>
        <input type="number" name="levelAdvancement.{{@key}}.xp" value="{{this.xp}}" />
        <label>FA</label>
        <input type="number" name="levelAdvancement.{{@key}}.fa" value="{{this.fa}}" />
        <label>CA</label>
        <input type="number" name="levelAdvancement.{{@key}}.ca" value="{{this.ca}}" />
        <label>TA</label>
        <input type="number" name="levelAdvancement.{{@key}}.ta" value="{{this.ta}}" />
      </div>
    {{/each}} --}}
  </fieldset>

  <fieldset>
    <legend>Starting Pack</legend>
    <div class="form-group">
      <label for="classData.startingPack.gold">Starting Gold</label>
      <input type="text" name="classData.startingPack.gold" value="{{classData.startingPack.gold}}" placeholder="1d4+1" />
    </div>

    {{#each classData.startingPack}}
      {{#unless (eq @key "gold")}}
        <div class="form-group">
          <label>{{@key}}</label>
          {{#each this}}
            <div>
              <input type="text" name="classData.startingPack.{{@../key}}.{{@index}}.name" value="{{this.name}}" placeholder="Item Name" />
              <input type="number" name="classData.startingPack.{{@../key}}.{{@index}}.quantity" value="{{this.quantity}}" placeholder="Qty" />
            </div>
          {{/each}}
        </div>
      {{/unless}}
    {{/each}}
  </fieldset>

  <button class="save-class">Save Class</button>
</form>
