{{!-- templates/apps/class-editor.hbs --}}
<form autocomplete="off">
  <fieldset>
    <legend>Class Info</legend>
    <div class="form-group flex flexrow flex-group-center container">
        <span class="flex-item">
            <input type="text" name="name" value="{{classKey}}" /><br />
            <label for="name">Class Name</label>
        </span>
        <span class="flex-item">
            <input type="text" name="classData.hitDie" value="{{classData.hitDie}}" placeholder="e.g., 1d6, 1d8" /><br />
            <label for="classData.hitDie">Hit Die</label>
        </span>
        <span class="flex-item">
            <select name="classData.baseClass">
                <option value=""></option>
                {{selectOptions baseClasses selected=classData.baseClass localize=false}}
            </select><br />
            <label for="classData.baseClass">Base Class</label>
            <p style="font-style: italic;">Determines the critical hit & miss columns to use.</p>
        </span>
    </div>
  </fieldset>
  
  <fieldset>
    <legend>Attribute Requirements / Minimums</legend>
        <div class="flex flexrow flex-group-center form-group container">
            {{#each attrReqs}}
            <span>
                <input type="number" class="input-small" name="classData.attrReqs.{{@key}}" value="{{this.value}}" /><br />
                <label for="classData.attrReqs.{{@key}}">{{this.label}}</label>
            </span>
            {{/each}}
        </div>
  </fieldset>

  <fieldset>
    <legend>XP Bonus Requirements</legend>
        <p>Minimum attribute scores required to earn a 10% bonus to XP.</p>
        <div class="flex flexrow flex-group-center form-group container">
            {{#each xpBonusReqs}}
            <span>
                <input type="number" class="input-small" name="classData.xpBonusReq.{{@key}}" value="{{this.value}}" /><br />
                <label for="classData.xpBonusReq.{{@key}}">{{this.label}}</label>
            </span>
            {{/each}}
        </div>
  </fieldset>

  <fieldset>
    <legend>Extraordinary Feat Bonus %</legend>
        <p>Some classes get a +8% bonus on one or two physical feats.</p>
        <div class="flex flexrow flex-group-center form-group container">
            <span>
                <input type="number" class="input-small" name="classData.featBonus.str" value="{{classData.featBonus.str}}" /><br />
                <label for="classData.featBonus.str">{{localize 'HYP3E.attributes.str.feat'}}</label>
            </span>
            <span>
                <input type="number" class="input-small" name="classData.featBonus.dex" value="{{classData.featBonus.dex}}" /><br />
                <label for="classData.featBonus.dex">{{localize 'HYP3E.attributes.dex.feat'}}</label>
            </span>
            <span>
                <input type="number" class="input-small" name="classData.featBonus.con" value="{{classData.featBonus.con}}" /><br />
                <label for="classData.featBonus.con">{{localize 'HYP3E.attributes.con.feat'}}</label>
            </span>
        </div>
  </fieldset>

  <fieldset>
    <legend>Spell Lists</legend>
        <p>If the class can cast spells, make one or two selections here.</p>
        <div class="flex flexrow flex-group-center form-group container">
            {{#each classData.spellLists}}
            <span class="flex-item">
                {{!-- <input type="text" name="classData.spellLists.{{@index}}" value="{{this}}"> --}}
                <select name="classData.spellLists.{{@index}}">
                    <option value=""></option>
                    {{selectOptions @root.spellLists selected=this localize=false}}
                </select>
                <br />
                <label for="classData.spellLists.{{@index}}">Spell List {{add @index 1}}</label>        
            </span>
            {{/each}}
        </div>
  </fieldset>

  <fieldset>
    <legend>Saving Throws at 1st Level</legend>
        <p>Note: Most classes get a +2 bonus on two of their saving throws.</p>
        <div class="flex flexrow flex-group-center form-group container">
            {{#each saves}}
            <span>
                <input type="number" class="input-small" name="classData.saves.{{@key}}" value="{{this.value}}" /><br />
                <label for="classData.saves.{{@key}}">{{this.label}}</label>
            </span>
            {{/each}}
        </div>
  </fieldset>

  <fieldset>
        <legend>Level Advancement</legend>
        <table>
            <thead>
                <tr class="level-advancement">
                    <th>Level</th>
                    <th>XP</th>
                    <th>HP Roll</th>
                    <th>FA</th>
                    <th>CA</th>
                    <th>TA</th>
                </tr>
            </thead>
            <tbody>
                {{#each classData.levelAdvancement}}
                <tr class="level-advancement">
                    <td>{{@key}}</td>
                    <td><input type="number" name="classData.levelAdvancement.{{@key}}.xp" value="{{this.xp}}" /></td>
                    <td><input class="input-small" type="text" name="classData.levelAdvancement.{{@key}}.hpRoll" value="{{this.hpRoll}}" /></td>
                    <td><input class="input-small" type="number" name="classData.levelAdvancement.{{@key}}.fa" value="{{this.fa}}" /></td>
                    <td><input class="input-small" type="number" name="classData.levelAdvancement.{{@key}}.ca" value="{{this.ca}}" /></td>
                    <td><input class="input-small" type="number" name="classData.levelAdvancement.{{@key}}.ta" value="{{this.ta}}" /></td>
                </tr>
                {{/each}}
            </tbody>
        </table>
  </fieldset>

  <fieldset>
    <legend>Starting Pack</legend>
    <p>Define the starting equipment pack for this class.</p>
    <div class="flex flexrow flex-group-center form-group container">
        <div class="flex" style="margin-right: 2px;">
            {{!-- General Equipment --}}
            {{#each equipmentPack}}
            <div class="flex">
                <label class="dialog-label">{{capitalizeWords @key}}</label>
                {{#each this}}
                <div class="flex flexrow flex-group-center">
                    <select class="equipment-select" name="classData.startingPack.{{@../key}}.{{@index}}.name">
                        <option value=""></option>
                        {{#if (eq @../key "equipment - general")}}
                            {{selectOptions @root.gearOptions selected=this.name localize=false}}
                        {{else if (eq @../key "equipment - provisions")}}
                            {{selectOptions @root.provisionOptions selected=this.name localize=false}}
                        {{else if (eq @../key "equipment - religious")}}
                            {{selectOptions @root.religiousOptions selected=this.name localize=false}}
                        {{/if}}
                    </select>
                    <input type="number" class="input-small" name="classData.startingPack.{{@../key}}.{{@index}}.quantity" value="{{this.quantity}}" placeholder="Qty" />
                    <button type="button" class="delete-item button-narrow" data-pack="{{@../key}}" data-index="{{@index}}"><i class="fas fa-trash"></i></button>
                </div>
                {{/each}}
                <button type="button" class="add-item" data-pack="{{@key}}"><i class="fas fa-plus"></i> Add</button>
            </div>
            <hr />
            {{/each}}
        </div>
        <div class="flex">
            {{!-- Other categories: gold, armour, weapons, provisions, religious items --}}
            {{#each corePack}}
            <div class="flex" style="margin-left: 2px;">
                <label class="dialog-label">{{capitalizeWords @key}}</label>
                {{#if (eq @key "gold")}}
                <input type="text" name="classData.startingPack.gold" value="{{this}}" placeholder="Gold Amount" />
                {{else}}
                {{#each this}}
                <div class="flex flexrow flex-group-center">
                    <select class="equipment-select" name="classData.startingPack.{{@../key}}.{{@index}}.name">
                        <option value=""></option>
                        {{#if (eq @../key "armour")}}
                            {{selectOptions @root.armorOptions selected=this.name localize=false}}
                        {{else if (eq @../key "weapons")}}
                            {{selectOptions @root.weaponOptions selected=this.name localize=false}}
                        {{else if (eq @../key "equipment - provisions")}}
                            {{selectOptions @root.provisionOptions selected=this.name localize=false}}
                        {{else if (eq @../key "equipment - religious")}}
                            {{selectOptions @root.religiousOptions selected=this.name localize=false}}
                        {{/if}}
                    </select>
                    <input type="number" class="input-small" name="classData.startingPack.{{@../key}}.{{@index}}.quantity" value="{{this.quantity}}" placeholder="Qty" />
                    <button type="button" class="delete-item button-narrow" data-pack="{{@../key}}" data-index="{{@index}}"><i class="fas fa-trash"></i></button>
                </div>
                {{/each}}
                <button type="button" class="add-item" data-pack="{{@key}}"><i class="fas fa-plus"></i> Add</button>
                {{/if}}
                <hr />
            </div>
            {{/each}}
        </div>
    </div>
  </fieldset>

  <button class="save-class">Save Class</button>
</form>
