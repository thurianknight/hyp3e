<div class="combat-options">
  <h3>{{actor.name}}</h3>
  <hr class="plain-hr"/>
  <span style="font-weight: bold;">{{localize 'HYP3E.dataLabel.combatOptions'}} <i>({{localize 'HYP3E.settings.clickToToggle'}})</i></span>
  <ul>
    {{#each combatOptions as |opt id|}}
    <li>
      <a class='item-control {{#ifInList id ../actorCombatOptions}}item-in-list{{/ifInList}}' 
          data-action="toggleOption"
          data-option-id="{{id}}" role="button"
        >
        {{opt.nameLong}}
      </a>
    </li>
    {{/each}}
  </ul>
</div>
