<div style="padding-bottom: 5px">
    {{{headerHTML}}}
</div>

<div class="dice-roll" data-item-id="{{item.id}}" data-actor-id="{{actorId}}" data-action="expandRoll">
    <div class="dice-result">
        <div class="dice-formula">{{roll.formula}}</div>
        <div class="dice-tooltip">
            <div class="wrapper">
                <section class="tooltip-part">
                    {{{debugRollFormula}}}
                    <div class="dice">
                        {{#each roll.dice as |die key|}}
                        <header class="part-header flexrow">
                            <span class="part-formula">{{die.expression}}</span>
                            <span>
                                <ol class="dice-rolls">
                                    {{#each die.values as |val d|}}
                                    <li class="roll die d{{die.faces}} 
                                        {{isMin val}}
                                        {{isMax val die.faces}}">{{val}}</li>
                                    {{/each}}
                                </ol>
                            </span>
                            <span class="part-total">{{die.total}}</span>
                        </header>
                        {{/each}}
                    </div>
                </section>
            </div>
        </div>
        <div class="dice-total">{{roll.total}}</div>
    </div>
</div>
{{#unless roll.hit}}
<div class="dice-result">
    <div style="font-style:italic; margin-top: 5px;"><em>Override & roll damage anyway...</div>
</div>
{{/unless}}
{{!-- {{#if roll.hit}} --}}
<div class='dmg-roll-button' style='padding-top: 5px' data-item-id='{{item.id}}' 
    data-item-uuid='{{item.uuid}}' data-actor-id='{{actorId}}' data-token-id='{{tokenId}}' 
    data-base-damage='{{item.system.damage}}' data-damage-type='{{item.system.dmgType}}' 
    data-formula='{{dmgObj.primary.formula}}' data-debug-formula='{{dmgObj.primary.debugFormula}}' 
    data-damage-groups='{{{json dmgObj.primary.damageGroups}}}' data-source-type='{{item.type}}'>
</div>
{{#if dmgObj.secondary.formula}}
<div class='dmg-roll-button2h' style='padding-top: 2px' data-item-id='{{item.id}}' 
    data-item-uuid='{{item.uuid}}' data-actor-id='{{actorId}}' data-token-id='{{tokenId}}' 
    data-base-damage='{{item.system.damage2h}}' data-damage-type='{{item.system.dmgType}}' 
    data-formula='{{dmgObj.secondary.formula}}' data-debug-formula='{{dmgObj.secondary.debugFormula}}' 
    data-damage-groups='{{{json dmgObj.secondary.damageGroups}}}' data-source-type='{{item.type}}'>
</div>
{{/if}}
{{!-- {{/if}} --}}

<div style="padding-top: 5px">
    {{{footerHTML}}}
</div>
