<div class="message-content">
    {{!-- HTML-formatted content. Comes from item description. --}}
    {{{content}}}

    {{!-- If the item applies one or more effects, show an Apply Effects button --}}
    {{#if hasEffects}}
    <div class="apply-effects-button" data-item-id="{{item.id}}" data-actor-id="{{actor.id}}"></div>
    {{/if}}
</div>
