<div class="hyp3e-chat-card item-description">
  {{!-- HTML-formatted content. Comes from item description. --}}
  {{#if (isLongContent content)}} {{! Helper to check length, defined in your template registration }}
  <div class="description truncated">
    {{{content}}}
  </div>
  <a class="toggle-description" data-action="expand">▼ Expand Description</a>
  {{else}}
  <div class="description">
    {{{content}}}
  </div>
  {{/if}}
</div>